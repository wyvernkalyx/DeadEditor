<Window x:Class="DeadEditor.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player"
        Height="180" Width="450"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Winamp-style Raised/Beveled Button Style -->
        <Style x:Key="WinampButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="2">
                            <!-- Raised bevel effect: light top/left, dark bottom/right -->
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#666666" Offset="0"/>
                                    <GradientStop Color="#1a1a1a" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: slightly lighter face -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#4a4a4a"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Pressed state: invert bevel, shift content -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1a1a1a" Offset="0"/>
                                            <GradientStop Color="#666666" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="contentPresenter" Property="Margin" Value="1,1,0,0"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2a2a2a"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2a2a2a"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#3a3a3a"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#555555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>  <!-- Drag bar -->
                <RowDefinition Height="50"/>  <!-- Transport controls -->
                <RowDefinition Height="30"/>  <!-- Seek bar -->
                <RowDefinition Height="40"/>  <!-- Marquee -->
                <RowDefinition Height="36"/>  <!-- Volume/Balance -->
            </Grid.RowDefinitions>

            <!-- Drag Bar -->
            <Grid Grid.Row="0" Background="#2D2D30" MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>  <!-- Menu icon -->
                    <ColumnDefinition Width="*"/>   <!-- Drag area -->
                    <ColumnDefinition Width="60"/>  <!-- Minimize + Close buttons -->
                </Grid.ColumnDefinitions>

                <!-- Menu Icon -->
                <TextBlock Grid.Column="0" Text="≡" FontSize="16" Foreground="#CCCCCC"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Drag Area Label -->
                <TextBlock Grid.Column="1" Text="PLAYER" FontSize="10" Foreground="#808080"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" IsHitTestVisible="False"/>

                <!-- Minimize Button -->
                <Button Grid.Column="2" Content="_" Width="30" Height="24"
                        Click="MinimizeButton_Click"
                        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top" Padding="0,-4,0,0"/>

                <!-- Close Button -->
                <Button x:Name="CloseButton" Grid.Column="2" Content="×" Width="30" Height="24"
                        Margin="30,0,0,0"
                        Click="CloseButton_Click"
                        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                        FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Transport Controls Row -->
            <Grid Grid.Row="1" Background="#252526">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transport Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="PreviousButton" Content="&#xE892;" Width="40" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="PreviousButton_Click"
                            Background="#3a3a3a" Foreground="#CCCCCC"
                            FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"/>

                    <Button x:Name="PlayButton" Content="&#xE768;" Width="50" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="PlayButton_Click"
                            Background="#0E639C" Foreground="#FFFFFF"
                            FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Bold" Margin="0,0,5,0"/>

                    <Button x:Name="StopButton" Content="&#xE71A;" Width="40" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="StopButton_Click"
                            Background="#3a3a3a" Foreground="#CCCCCC"
                            FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"/>

                    <Button x:Name="NextButton" Content="&#xE893;" Width="40" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="NextButton_Click"
                            Background="#3a3a3a" Foreground="#CCCCCC"
                            FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"/>

                    <!-- Separator -->
                    <Border Width="1" Background="#555555" Margin="5,5,5,5"/>

                    <!-- Playlist Button -->
                    <Button x:Name="PlaylistButton" Content="Playlist" Width="60" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="PlaylistButton_Click"
                            Background="#3a3a3a" Foreground="#CCCCCC"
                            FontSize="9" FontWeight="Bold" Margin="5,0,5,0"/>

                    <!-- Visualizer Button -->
                    <Button x:Name="VisButton" Content="Visualizer" Width="70" Height="35"
                            Style="{StaticResource WinampButtonStyle}"
                            Click="VisButton_Click"
                            Background="#3a3a3a" Foreground="#CCCCCC"
                            FontSize="9" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Seek Bar Row -->
            <Grid Grid.Row="2" Background="#1E1E1E" Margin="10,5,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Seek Slider -->
                <Slider x:Name="SeekSlider" Grid.Column="0"
                        Minimum="0" Maximum="100" Value="0"
                        VerticalAlignment="Center"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp"/>

                <!-- Time Display -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#CCCCCC" FontSize="11"/>
                    <TextBlock Text=" / " Foreground="#808080" FontSize="11"/>
                    <TextBlock x:Name="TotalTimeText" Text="0:00" Foreground="#CCCCCC" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Marquee Row -->
            <Border Grid.Row="3" Background="#252526" Margin="10,5,10,5" BorderBrush="#555555" BorderThickness="1">
                <Grid>
                    <Canvas x:Name="MarqueeCanvas" ClipToBounds="True">
                        <TextBlock x:Name="MarqueeText"
                                   Text="No track playing"
                                   Foreground="#D7BA7D" FontSize="14" FontWeight="Normal"
                                   Canvas.Left="0" Canvas.Top="8">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="MarqueeTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Volume and Balance Row -->
            <Grid Grid.Row="4" Background="#1E1E1E" Margin="10,5,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Volume Label -->
                <TextBlock Grid.Column="0" Text="VOL:" Foreground="#CCCCCC" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>

                <!-- Volume Slider -->
                <Slider x:Name="VolumeSlider" Grid.Column="1"
                        Minimum="0" Maximum="100" Value="75"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged"/>

                <!-- Balance Label -->
                <TextBlock Grid.Column="3" Text="BAL:" Foreground="#CCCCCC" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>

                <!-- Balance Slider (placeholder, not yet functional) -->
                <Slider x:Name="BalanceSlider" Grid.Column="4"
                        Minimum="0" Maximum="100" Value="50"
                        VerticalAlignment="Center"
                        IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
