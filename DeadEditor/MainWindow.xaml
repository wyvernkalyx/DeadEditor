<Window x:Class="DeadEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadEditor"
        mc:Ignorable="d"
        Title="Dead Editor - Import" Height="750" Width="1200"
        Background="#1E1E1E"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <!-- Dark Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#13A10E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="6,3,6,3"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextBlock.Foreground="#FFFFFF"/>
                                    <Path Name="Arrow"
                                          Grid.Column="1"
                                          Fill="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </ToggleButton>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderThickness="1"
                                            BorderBrush="#555555"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#FFFFFF" FontSize="14">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#094771"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <!-- Folder Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Action Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Album Info Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Main Content (Track List + Artwork) -->
                <RowDefinition Height="*"/>
                <!-- Playback Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== SECTION 1: FOLDER BAR ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BrowseButton" Content="Select Folder..."
                        Width="140" Height="32" Margin="0,0,10,0"
                        Click="BrowseButton_Click" FontSize="14"/>
                <TextBox Grid.Column="1" x:Name="FolderPathTextBox"
                         VerticalAlignment="Center" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13" Background="#2D2D30"/>
            </Grid>

            <!-- ===== SECTION 2: ACTION BAR ===== -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ReadButton" Content="Read" Height="32"
                            Click="ReadButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Read metadata from audio files"/>
                    <Button x:Name="MusicBrainzButton" Content="🔎 MusicBrainz" Height="32"
                            Style="{StaticResource AccentButton}"
                            Click="MusicBrainzButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Lookup album on MusicBrainz"/>
                    <Button x:Name="NormalizeButton" Content="✨ Normalize" Height="32"
                            Style="{StaticResource AccentButton}"
                            Click="NormalizeButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Normalize all song titles"/>
                    <Button x:Name="RenumberButton" Content="Renumber" Height="32"
                            Click="RenumberButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Renumber tracks sequentially"/>
                    <Button x:Name="ViewInfoButton" Content="View Info" Height="32"
                            Click="ViewInfoButton_Click" Margin="0,0,6,0" FontSize="13"
                            IsEnabled="False"
                            ToolTip="View info file"/>
                </StackPanel>

                <!-- Center: Status Text -->
                <TextBlock Grid.Column="1" x:Name="StatusTextBlock"
                           Text="Ready" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#CCCCCC"/>

                <!-- Right: Write/Import Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="WriteButton" Content="Write to Files" Height="32"
                            Click="WriteButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Write metadata to audio files"/>
                    <Button x:Name="ImportButton" Content="Import to Library" Height="32"
                            Style="{StaticResource PrimaryButton}"
                            Click="ImportButton_Click" Margin="0,0,6,0" FontSize="13"
                            ToolTip="Import to library"/>
                    <Button x:Name="CancelButton" Content="Cancel" Height="32"
                            Click="CancelButton_Click" FontSize="13"
                            ToolTip="Close window"/>
                </StackPanel>
            </Grid>

            <!-- ===== SECTION 3: ALBUM INFO BAR ===== -->
            <Border Grid.Row="2" BorderBrush="#555555" BorderThickness="1"
                    Background="#2D2D30" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Artist -->
                    <Label Grid.Row="0" Grid.Column="0" Content="ARTIST" VerticalAlignment="Top"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="ArtistTextBox"
                             Width="140" Height="26" TextChanged="AlbumInfo_Changed"/>

                    <!-- Album Date -->
                    <Label Grid.Row="0" Grid.Column="1" Content="ALBUM DATE" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlbumDateTextBox"
                             Height="26" Margin="10,0,0,0" TextChanged="AlbumInfo_Changed"
                             ToolTip="yyyy-MM-dd"/>

                    <!-- Venue -->
                    <Label Grid.Row="0" Grid.Column="2" Content="VENUE" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="VenueTextBox"
                             Width="240" Height="26" Margin="10,0,0,0" TextChanged="AlbumInfo_Changed"/>

                    <!-- City, State -->
                    <Label Grid.Row="0" Grid.Column="3" Content="CITY, STATE" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="CityStateTextBox"
                             Height="26" Margin="10,0,0,0" TextChanged="AlbumInfo_Changed"
                             ToolTip="City, ST"/>

                    <!-- Album / Release Name -->
                    <Label Grid.Row="0" Grid.Column="4" Content="ALBUM / RELEASE NAME" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="AlbumNameTextBox"
                             Width="190" Height="26" Margin="10,0,0,0" TextChanged="AlbumInfo_Changed"
                             ToolTip="Optional"/>

                    <!-- Year -->
                    <Label Grid.Row="0" Grid.Column="5" Content="YEAR" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="YearTextBox"
                             Height="26" Margin="10,0,0,0" TextChanged="AlbumInfo_Changed"
                             ToolTip="Release year"/>
                </Grid>
            </Border>

            <!-- ===== SECTION 4: MAIN CONTENT (Track List + Artwork Panel) ===== -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Track List -->
                <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="1"
                        Background="#1E1E1E" Margin="0,0,10,0">
                    <DataGrid x:Name="TracksDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionChanged="TracksDataGrid_SelectionChanged"
                              LoadingRow="TracksDataGrid_LoadingRow"
                              CellEditEnding="TracksDataGrid_CellEditEnding"
                              PreparingCellForEdit="TracksDataGrid_PreparingCellForEdit"
                              Background="#1E1E1E"
                              Foreground="#FFFFFF"
                              RowBackground="#1E1E1E"
                              AlternatingRowBackground="#252526"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3F3F46"
                              FontSize="14"
                              RowHeight="28">
                        <DataGrid.Resources>
                            <!-- Style for editable cells -->
                            <Style x:Key="EditableCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#264F78"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEditing" Value="True">
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#252526"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#264F78"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A2D2E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Track Number (read-only) -->
                            <DataGridTextColumn Header="#" Binding="{Binding TrackNumber}"
                                                Width="40" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Title (editable, shows display title with auto-appended date) -->
                            <DataGridTemplateColumn Header="Title" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SongName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#3C3C3C"
                                                 Foreground="#FFFFFF"
                                                 BorderThickness="0"
                                                 Padding="4,0"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Segue Checkbox (editable) -->
                            <DataGridCheckBoxColumn Header="→" Binding="{Binding Segue, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- Track Date (editable, shows inherited or override) -->
                            <DataGridTemplateColumn Header="Date" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Padding="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TrackDate}"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontStyle" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <!-- If TrackDate is empty, show inherited date in gray italic -->
                                                        <DataTrigger Binding="{Binding TrackDate}" Value="">
                                                            <Setter Property="Text" Value="{Binding InheritedDate}"/>
                                                            <Setter Property="Foreground" Value="#777777"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrackDate}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding InheritedDate}"/>
                                                            <Setter Property="Foreground" Value="#777777"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TrackDate, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#3C3C3C"
                                                 Foreground="#FFFFFF"
                                                 BorderThickness="0"
                                                 Padding="4,0"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Duration (read-only) -->
                            <DataGridTextColumn Header="Time" Binding="{Binding Duration}"
                                                Width="60" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Artwork Panel -->
                <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="1"
                        Background="#2D2D30" Padding="10">
                    <StackPanel>
                        <!-- Artwork Display -->
                        <Border BorderBrush="#555555" BorderThickness="1"
                                Width="176" Height="176"
                                Background="#1E1E1E" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock x:Name="NoArtworkText" Text="No Artwork"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#777777" FontStyle="Italic" FontSize="12"/>
                                <Image x:Name="ArtworkImage" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Artwork Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Button x:Name="ChangeArtworkButton" Content="Change..."
                                    Width="80" Height="26" Margin="0,0,5,0"
                                    Click="ChangeArtworkButton_Click" FontSize="12"/>
                            <Button x:Name="RemoveArtworkButton" Content="Remove"
                                    Width="80" Height="26" Margin="5,0,0,0"
                                    Click="RemoveArtworkButton_Click" FontSize="12"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,10" Background="#555555"/>

                        <!-- Album Type Dropdown -->
                        <Label Content="ALBUM TYPE" Margin="0,0,0,3"/>
                        <ComboBox x:Name="AlbumTypeComboBox" Height="26" Margin="0,0,0,15"
                                  SelectionChanged="AlbumTypeComboBox_SelectionChanged"
                                  FontSize="13">
                            <ComboBoxItem Content="Auto-detect" IsSelected="True"/>
                            <ComboBoxItem Content="Audience Recording"/>
                            <ComboBoxItem Content="Official Release"/>
                        </ComboBox>

                        <Separator Margin="0,0,0,10" Background="#555555"/>

                        <!-- Folder Name Preview -->
                        <Label Content="FOLDER NAME PREVIEW" Margin="0,0,0,3"/>
                        <Border BorderBrush="#555555" BorderThickness="1"
                                Background="#1E1E1E" Padding="6" Margin="0,0,0,10" MinHeight="60">
                            <TextBlock x:Name="FolderPreviewTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#D7BA7D"
                                       FontSize="11"
                                       LineHeight="14"/>
                        </Border>

                        <!-- Write Path -->
                        <Label Content="WRITE PATH" Margin="0,0,0,3"/>
                        <Border BorderBrush="#555555" BorderThickness="1"
                                Background="#1E1E1E" Padding="6" MinHeight="50">
                            <TextBlock x:Name="WritePathTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#999999"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       LineHeight="12"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== SECTION 5: PLAYBACK BAR ===== -->
            <Border Grid.Row="4" BorderBrush="#555555" BorderThickness="1"
                    Background="#2D2D30" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transport Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousTrackButton" Content="⏮" Width="40" Height="30"
                                Margin="0,0,4,0" Click="PreviousTrackButton_Click"
                                IsEnabled="False" FontSize="14"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Width="50" Height="30"
                                Margin="0,0,4,0" Click="PlayPauseButton_Click"
                                IsEnabled="False" FontSize="14" FontWeight="Bold"/>
                        <Button x:Name="StopButton" Content="⏹" Width="40" Height="30"
                                Margin="0,0,4,0" Click="StopButton_Click"
                                IsEnabled="False" FontSize="14"/>
                        <Button x:Name="NextTrackButton" Content="⏭" Width="40" Height="30"
                                Margin="0,0,10,0" Click="NextTrackButton_Click"
                                IsEnabled="False" FontSize="14"/>

                        <!-- Now Playing Text -->
                        <TextBlock x:Name="NowPlayingText" Text="No track playing"
                                   FontSize="13" Foreground="#CCCCCC"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Progress Slider -->
                    <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="CurrentTimeText"
                                   Text="0:00" FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#CCCCCC"/>
                        <Slider Grid.Column="1" x:Name="ProgressSlider"
                                Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center"
                                PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                                PreviewMouseUp="ProgressSlider_PreviewMouseUp"
                                IsEnabled="False"/>
                        <TextBlock Grid.Column="2" x:Name="TotalTimeText"
                                   Text="0:00" FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#CCCCCC"/>
                    </Grid>

                    <!-- Volume Control -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="VolumeSlider" Width="80"
                                Minimum="0" Maximum="100" Value="75"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== SECTION 6: STATUS BAR ===== -->
            <Border Grid.Row="5" BorderBrush="#555555" BorderThickness="1,0,0,0"
                    Background="#252526" Padding="8,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="1" x:Name="ProgressBar"
                                 Height="3" Visibility="Collapsed"
                                 Minimum="0" Maximum="100"
                                 Background="#1E1E1E"
                                 Foreground="#0E639C"
                                 BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Notification Panel (Modal Overlay) - Grid.RowSpan to cover entire window -->
        <Grid x:Name="NotificationPanel" Grid.RowSpan="2" Panel.ZIndex="1000" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.7"/>
            </Grid.Background>
            <Border Background="#2D2D30"
                    BorderBrush="#007ACC"
                    BorderThickness="2"
                    CornerRadius="6"
                    MaxWidth="600"
                    MaxHeight="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25"
                    MouseDown="NotificationPanel_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30"
                                      ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="NotificationTitle"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,15" Foreground="#FFFFFF"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,20">
                        <TextBlock x:Name="NotificationMessage"
                                   TextWrapping="Wrap" FontSize="14"
                                   Foreground="#CCCCCC" LineHeight="20"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="NotificationYesButton" Content="Yes"
                                Width="100" Height="36" Margin="5"
                                Click="NotificationYes_Click" Visibility="Collapsed"
                                FontSize="14" FontWeight="SemiBold"/>
                        <Button x:Name="NotificationNoButton" Content="No"
                                Width="100" Height="36" Margin="5"
                                Click="NotificationNo_Click" Visibility="Collapsed"
                                FontSize="14"/>
                        <Button x:Name="NotificationOkButton" Content="OK"
                                Width="100" Height="36" Margin="5"
                                Click="NotificationOk_Click"
                                FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
