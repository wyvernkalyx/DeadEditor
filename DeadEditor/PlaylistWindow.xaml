<Window x:Class="DeadEditor.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeadEditor"
        Title="Playlist"
        Height="400" Width="450"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Topmost="False"
        ShowInTaskbar="False"
        MinHeight="200" MinWidth="350">

    <Window.Resources>
        <!-- DataGrid Row Style with Gold Highlight for Current Track -->
        <Style x:Key="PlaylistRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentTrack}" Value="True">
                    <Setter Property="Background" Value="#D7BA7D"/>
                    <Setter Property="Foreground" Value="#1E1E1E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#555555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>  <!-- Drag bar -->
                <RowDefinition Height="*"/>   <!-- DataGrid -->
                <RowDefinition Height="36"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Drag Bar -->
            <Grid Grid.Row="0" Background="#2D2D30" MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- Title -->
                    <ColumnDefinition Width="60"/>  <!-- Minimize + Detach buttons -->
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Column="0" Text="PLAYLIST EDITOR" FontSize="11" Foreground="#CCCCCC"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontWeight="Bold"/>

                <!-- Minimize Button -->
                <Button Grid.Column="1" Content="_" Width="30" Height="28"
                        Click="MinimizeButton_Click"
                        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top" Padding="0,-4,0,0"/>

                <!-- Detach Button -->
                <Button x:Name="DetachButton" Grid.Column="1" Content="■" Width="30" Height="28"
                        Margin="30,0,0,0"
                        Click="DetachButton_Click"
                        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                        FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Playlist DataGrid -->
            <DataGrid Grid.Row="1" x:Name="PlaylistDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3E3E42"
                      SelectionMode="Single"
                      Background="#1E1E1E"
                      Foreground="#CCCCCC"
                      BorderThickness="0"
                      RowStyle="{StaticResource PlaylistRowStyle}"
                      MouseDoubleClick="PlaylistDataGrid_MouseDoubleClick">

                <!-- Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42">
                        <MenuItem Header="🎵 Go to Concert" Click="GoToConcert_Click" x:Name="GoToConcertMenuItem"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Resources>
                    <!-- Column Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <!-- Cell Style -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Track Number Column -->
                    <DataGridTextColumn Header="#" Width="50" Binding="{Binding TrackNumber}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Title Column -->
                    <DataGridTextColumn Header="Title" Width="*" Binding="{Binding DisplayTitle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Date Column -->
                    <DataGridTextColumn Header="Date" Width="95" Binding="{Binding ShortDate}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Duration Column -->
                    <DataGridTextColumn Header="Time" Width="60" Binding="{Binding Duration}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add Button (placeholder) -->
                    <Button Grid.Column="0" Content="+ Add" Width="70" Height="26"
                            Margin="0,0,10,0" IsEnabled="False"
                            Background="#3E3E42" Foreground="#808080" BorderBrush="#555555"
                            BorderThickness="1" FontSize="11"/>

                    <!-- Clear Button -->
                    <Button Grid.Column="1" Content="✕ Clear" Width="70" Height="26"
                            Click="ClearButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"
                            BorderThickness="1" FontSize="11"/>

                    <!-- Track Count and Total Duration -->
                    <TextBlock Grid.Column="3" x:Name="FooterStatsText"
                               Text="0 tracks  0:00"
                               Foreground="#CCCCCC" FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
