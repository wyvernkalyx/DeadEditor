<Window x:Class="DeadEditor.LibraryBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadEditor"
        xmlns:models="clr-namespace:DeadEditor.Models"
        xmlns:converters="clr-namespace:DeadEditor.Converters"
        mc:Ignorable="d"
        Title="DeadEditor - Library" Height="800" Width="1200"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Date Header Converter -->
        <local:DateHeaderConverter x:Key="DateHeaderConverter"/>

        <!-- Date Selection Converter -->
        <converters:DateSelectionConverter x:Key="DateSelectionConverter"/>

        <!-- ComboBox Style (copied from MainWindow.xaml - working perfectly) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="6,3,6,3"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextBlock.Foreground="#FFFFFF"/>
                                    <Path Name="Arrow"
                                          Grid.Column="1"
                                          Fill="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </ToggleButton>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderThickness="1"
                                            BorderBrush="#555555"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#CCCCCC" FontSize="16">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#094771"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Foreground="#CCCCCC">
                <MenuItem Header="_Import New Concert..." Click="ImportMenuItem_Click" FontSize="16"/>
                <Separator/>
                <MenuItem Header="_Settings" Click="SettingsMenuItem_Click" FontSize="16"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" FontSize="16"/>
            </MenuItem>

            <!-- Right-aligned Player toggle button -->
            <MenuItem x:Name="PlayerToggleMenuItem" Header="🎵 _Player" Foreground="#CCCCCC"
                      Click="PlayerToggleMenuItem_Click" InputGestureText="Ctrl+P"
                      HorizontalAlignment="Right"/>
        </Menu>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Show:" Foreground="#CCCCCC" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="TypeFilterComboBox" Width="200" Height="32"
                          FontSize="16" FontWeight="SemiBold" SelectedIndex="0"
                          SelectionChanged="TypeFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="All"/>
                    <ComboBoxItem Content="🎸 Audience Recordings" Tag="AudienceRecording"/>
                    <ComboBoxItem Content="📀 Official Releases" Tag="OfficialRelease"/>
                    <ComboBoxItem Content="📅 By Date" Tag="ByDate"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Search:" Foreground="#CCCCCC" FontSize="14"
                           VerticalAlignment="Center" Margin="20,0,10,0"/>

                <TextBox Grid.Column="3" x:Name="QuickSearchTextBox"
                         Height="32" FontSize="14"
                         Background="#3C3C3C" Foreground="#CCCCCC"
                         BorderBrush="#555555" BorderThickness="1"
                         Padding="8,6"
                         TextChanged="QuickSearchTextBox_TextChanged"
                         ToolTip="Quick search: date, venue, location, album name, year, edition, or official release. For song searches, use Advanced Search."/>

                <Button Grid.Column="4" x:Name="ClearSearchButton" Content="✕" Width="32" Height="32"
                        Margin="8,0,0,0" Click="ClearSearchButton_Click"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                        FontSize="14" FontWeight="Bold"
                        ToolTip="Clear search"
                        Visibility="Collapsed"/>

                <Button Grid.Column="5" x:Name="AdvancedSearchButton" Content="Advanced Search..." Width="150" Height="32"
                        Margin="12,0,0,0" Click="AdvancedSearchButton_Click"
                        Background="#094771" Foreground="#FFFFFF" BorderBrush="#0E639C"
                        FontSize="13" FontWeight="SemiBold"/>

                <TextBlock Grid.Column="6" x:Name="SearchResultTextBlock" Text=""
                           Foreground="#888888" FontSize="13"
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>

        <!-- Library List View -->
        <Grid x:Name="LibraryView" Grid.Row="2" Visibility="Visible">
            <DataGrid x:Name="ShowsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="#252526"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D30"
                      Foreground="#CCCCCC"
                      BorderThickness="0"
                      Margin="20"
                      MouseDoubleClick="ShowsDataGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#808080"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,16"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="MinHeight" Value="52"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#37373D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#094771"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,16"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding TypeIcon}" Width="50"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                    <DataGridTextColumn Header="Venue" Binding="{Binding Venue}" Width="*"/>
                    <DataGridTextColumn Header="City, State" Binding="{Binding Location}" Width="200"/>
                    <DataGridTextColumn Header="Album Name" Binding="{Binding DisplayAlbumName}" Width="250"/>
                    <DataGridTextColumn Header="Tracks" Binding="{Binding TrackCount}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Concert Detail View -->
        <Grid x:Name="ConcertView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Back Button and Edit Button -->
            <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,14">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="← Back to Library" Click="BackButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"
                            Padding="15,10" FontSize="16" Margin="0,0,10,0"/>
                    <Button x:Name="EditMetadataButton" Content="Edit Metadata..." Click="EditMetadataButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"
                            Padding="15,10" FontSize="16"/>
                </StackPanel>
            </Border>

            <!-- Concert Content -->
            <Grid Grid.Row="1" Margin="30,30,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Album Artwork and Info -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <!-- Artwork with placeholder -->
                    <Border Background="#2D2D30" CornerRadius="8" Margin="0,0,0,25">
                        <Grid Width="300" Height="300">
                            <!-- Placeholder -->
                            <Grid x:Name="ArtworkPlaceholder">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3E3E42" Offset="0"/>
                                        <GradientStop Color="#2D2D30" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Viewbox Width="140" Height="140">
                                    <TextBlock Text="🎵" Foreground="#787878" FontSize="100"/>
                                </Viewbox>
                            </Grid>
                            <!-- Actual artwork -->
                            <Image x:Name="AlbumArtwork" Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <!-- Concert Info -->
                    <!-- Album/Collection Name (always visible) -->
                    <TextBlock x:Name="AlbumNameText"
                               FontWeight="SemiBold"
                               FontSize="26"
                               TextWrapping="Wrap"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,10"/>

                    <!-- JerryBase Search Link -->
                    <Button x:Name="JerryBaseSearchButton"
                            Click="JerryBaseSearchButton_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="LinkText"
                                                       FontSize="13"
                                                       Foreground="#D7BA7D"
                                                       Cursor="{TemplateBinding Cursor}">
                                                <Run Text="🔍"/>
                                                <Run Text=" Search JerryBase"/>
                                            </TextBlock>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                                                    <Setter TargetName="LinkText" Property="Foreground" Value="#E5C890"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Venue/Date/Location (hidden for multi-night shows) -->
                    <TextBlock x:Name="VenueText"
                               FontWeight="SemiBold"
                               FontSize="26"
                               TextWrapping="Wrap"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="LocationText"
                               FontSize="18"
                               Foreground="#9CDCFE"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="DateText"
                               FontSize="18"
                               Foreground="#B5CEA8"
                               Margin="0,0,0,6"/>

                    <!-- Box Set / Official Release info -->
                    <TextBlock x:Name="BoxSetText"
                               FontSize="16"
                               Foreground="#D7BA7D"
                               Visibility="Collapsed"
                               Margin="0,0,0,6"/>

                    <!-- Album Type and Track Count (always visible) -->
                    <TextBlock x:Name="AlbumTypeText"
                               FontSize="16"
                               Foreground="#808080"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TrackCountText"
                               FontSize="16"
                               Foreground="#808080"/>

                    <!-- Date Navigation Links (Multi-Night Shows Only) -->
                    <StackPanel x:Name="DateLinksPanel"
                                Visibility="Collapsed"
                                Margin="0,20,0,0">
                        <TextBlock Text="JUMP TO DATE"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#808080"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="300"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DateLinksItemsControl"
                                          ItemsSource="{Binding ConcertDates, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Click="DateLink_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,4"
                                                HorizontalAlignment="Left"
                                                FontSize="15">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="Indicator"
                                                                               Text="●"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0"
                                                                               Visibility="Collapsed"/>
                                                                    <TextBlock x:Name="LinkText"
                                                                               Text="{TemplateBinding Content}"
                                                                               FontSize="{TemplateBinding FontSize}"
                                                                               Padding="{TemplateBinding Padding}"
                                                                               Cursor="{TemplateBinding Cursor}"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Selected state: check if this date matches SelectedDate -->
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource DateSelectionConverter}">
                                                                                <Binding/>
                                                                                <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="LinkText" Property="Foreground" Value="#E5C890"/>
                                                                        <Setter TargetName="LinkText" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="Indicator" Property="Foreground" Value="#E5C890"/>
                                                                        <Setter TargetName="Indicator" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <!-- Default (not selected) state -->
                                                                    <DataTrigger Value="False">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource DateSelectionConverter}">
                                                                                <Binding/>
                                                                                <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="LinkText" Property="Foreground" Value="#D7BA7D"/>
                                                                        <Setter TargetName="LinkText" Property="FontWeight" Value="Normal"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Track List -->
                <Border Grid.Column="1"
                        Background="#252526"
                        CornerRadius="8"
                        BorderBrush="#3F3F46"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                BorderThickness="0,0,0,1"
                                Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <!-- Expand/Collapse All buttons (multi-night shows only) -->
                                <StackPanel x:Name="ExpandCollapseButtons"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed"
                                            Margin="0,0,12,0">
                                    <Button x:Name="ExpandAllButton"
                                            Content="⊞"
                                            Click="ExpandAllButton_Click"
                                            ToolTip="Expand All"
                                            Width="24"
                                            Height="24"
                                            FontSize="16"
                                            Foreground="#808080"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                       FontSize="{TemplateBinding FontSize}"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Cursor="{TemplateBinding Cursor}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="CollapseAllButton"
                                            Content="⊟"
                                            Click="CollapseAllButton_Click"
                                            ToolTip="Collapse All"
                                            Width="24"
                                            Height="24"
                                            FontSize="16"
                                            Foreground="#808080"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                       FontSize="{TemplateBinding FontSize}"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Cursor="{TemplateBinding Cursor}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="TRACKS"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#CCCCCC"/>
                            </StackPanel>
                        </Border>

                        <!-- Track List -->
                        <DataGrid Grid.Row="1"
                                  x:Name="TracksDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="#252526"
                                  RowBackground="#252526"
                                  AlternatingRowBackground="#2D2D30"
                                  Foreground="#CCCCCC"
                                  BorderThickness="0"
                                  Margin="5"
                                  LoadingRow="TracksDataGrid_LoadingRow"
                                  MouseLeftButtonUp="TracksDataGrid_MouseLeftButtonUp">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#252526"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="14,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="MinHeight" Value="42"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#37373D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#094771"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Track Number Column - shows chevron for headers, number for tracks -->
                                <DataGridTemplateColumn Header="#" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                                <ContentControl.Resources>
                                                    <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                                        <Border Background="#1A1A2E" BorderBrush="#D7BA7D" BorderThickness="3,0,0,0" MinHeight="36" Padding="14,0,0,0">
                                                            <TextBlock Text="{Binding ChevronIcon}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                                        <TextBlock Text="{Binding Track.TrackNumber}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Title Column - shows header text for headers, track title for tracks -->
                                <DataGridTemplateColumn Header="Title" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                                <ContentControl.Resources>
                                                    <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                                        <Border Background="#1A1A2E" MinHeight="36" Padding="0">
                                                            <TextBlock Text="{Binding HeaderText}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                                        <TextBlock Text="{Binding Track.DisplayTitle}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Duration Column - shows track count for headers, duration for tracks -->
                                <DataGridTemplateColumn Header="Duration" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                                <ContentControl.Resources>
                                                    <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                                        <Border Background="#1A1A2E" MinHeight="36" Padding="0">
                                                            <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} tracks'}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                                        <TextBlock Text="{Binding Track.Duration}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ContentControl.Resources>
                                            </ContentControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="20,18">
            <TextBlock x:Name="StatusText" Text="Double-click a concert to open" FontSize="16" Foreground="#808080"/>
        </Border>
    </Grid>
</Window>
