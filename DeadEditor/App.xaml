<Application x:Class="DeadEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeadEditor">
    <Application.Resources>
        <!-- Workflow stepper palette (consumed by Controls/WorkflowStepper.xaml.cs) -->
        <SolidColorBrush x:Key="PillCompletedBg"      Color="#0E7A0D"/>
        <SolidColorBrush x:Key="PillCurrentBg"        Color="#0E639C"/>
        <SolidColorBrush x:Key="PillUpcomingBg"       Color="#2D2D30"/>
        <SolidColorBrush x:Key="PillCompletedFg"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PillCurrentFg"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PillUpcomingFg"       Color="#888888"/>
        <SolidColorBrush x:Key="PillSkippedFg"        Color="#888888"/>
        <SolidColorBrush x:Key="PillSkippedAccent"    Color="#F0AD4E"/>
        <SolidColorBrush x:Key="ConnectorCompletedBg" Color="#0E7A0D"/>
        <SolidColorBrush x:Key="ConnectorDimBg"       Color="#3F3F46"/>

        <!-- Verification badge palette (consumed by EditMetadataView.UpdateVerificationBadge) -->
        <SolidColorBrush x:Key="BadgeVerifiedBg"      Color="#0E7A0D"/>
        <SolidColorBrush x:Key="BadgeVerifiedFg"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BadgeUnverifiedBg"    Color="#3C3C3C"/>
        <SolidColorBrush x:Key="BadgeUnverifiedFg"    Color="#888888"/>
        <!-- Brighter green for the verified glyph used as a FOREGROUND on dark grid rows
             (Library verification column). Distinct from BadgeVerifiedBg, which is a badge
             background in EditMetadataView and reads too dark when used as a foreground. -->
        <SolidColorBrush x:Key="BadgeVerifiedGlyph"   Color="#4EAA3F"/>

        <!-- Edit markers (reserved for prompt 6's amber left-edge marker on changed cells/inputs) -->
        <SolidColorBrush x:Key="MarkerAmberAccent"    Color="#F0AD4E"/>

        <!-- Shared keyed button style. Centralized here (was duplicated identically in
             ImportView + EditMetadataView). PrimaryButton/TertiaryButton remain per-view
             (PrimaryButton key is overloaded; TertiaryButton is single-consumer). -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Vertical padding kept tight (4, not 6) so the 16pt label centers within the
                 consumers' fixed Height=32 instead of overflowing low; horizontal padding (12)
                 and the fixed height are unchanged, so the footprint is identical. -->
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Template modeled on ImportView's TertiaryButton (same Border/ContentPresenter
                 structure, square corners, ControlTemplate.Triggers). Enabled state flows from
                 the setters above via TemplateBinding; the disabled state uses the muted-badge
                 pair so a disabled AccentButton reads as deliberately inactive, not system
                 washed-out. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A4F80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BadgeUnverifiedBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="{StaticResource BadgeUnverifiedFg}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared ghost button. Promoted from ImportView-local to App.xaml on its second
             consumer (EditMetadataView's Renumber). Self-contained (literal colors, no BasedOn). -->
        <Style x:Key="TertiaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBox Style (supports both editable and non-editable modes) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Grid.Column="2"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="#FFFFFF"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Background="{TemplateBinding Background}"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     Margin="3,3,23,3"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Focusable="True"/>
                            <Path Name="Arrow"
                                  Fill="#FFFFFF"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderThickness="1"
                                            BorderBrush="#555555"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
