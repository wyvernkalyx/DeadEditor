<UserControl x:Class="DeadEditor.SetlistReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="320"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- One setlist row. Dims to 0.4 opacity when the entry is claimed by a matched track. -->
        <Style x:Key="SetlistRowStyle" TargetType="Border">
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClaimed}" Value="True">
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl Background="#1E1E1E" BorderThickness="0">
        <TabItem Header="Setlist">
            <Grid Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: song count -->
                <Border Grid.Row="0" Background="#2D2D30" Padding="10,6"
                        BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="SetlistCountText" Foreground="#CCCCCC" FontSize="13"/>
                </Border>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState" Grid.Row="1"
                           Text="No setlist for this date."
                           Foreground="#888888" FontSize="14"
                           Margin="12" TextWrapping="Wrap"
                           Visibility="Visible"/>

                <!-- Setlist rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SetlistItems" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SetlistRowStyle}"
                                        Padding="10,4" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Flattened position (1-based for display) -->
                                        <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                                                   Foreground="#888888" FontSize="13"
                                                   MinWidth="24" Margin="0,0,8,0"/>

                                        <!-- Song name + segue marker -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#EEEEEE"
                                                       FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SegueMarker}" Foreground="#E0A030"
                                                       FontSize="14" FontWeight="Bold" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <!-- Set label -->
                                        <TextBlock Grid.Column="2" Text="{Binding SetLabel}"
                                                   Foreground="#888888" FontSize="12"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
