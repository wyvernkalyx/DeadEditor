<Window x:Class="DeadEditor.PullCollisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date Already Has Tracks" Height="210" Width="480"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- Self-contained dark theme (mirrors MatchToSongDialog) so the dialog reads correctly
         regardless of which view opens it; the synchronous pull path needs no other wiring. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Replace is the consequential, primary action — give it the accent fill. -->
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="This date already has tracks"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" x:Name="MessageText"
                   Foreground="#CCCCCC" FontSize="14"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Replace" Width="110" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="ReplaceButton_Click"/>
            <Button Content="Append" Width="110" Margin="0,0,10,0"
                    Click="AppendButton_Click"/>
            <Button Content="Cancel" Width="110"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
