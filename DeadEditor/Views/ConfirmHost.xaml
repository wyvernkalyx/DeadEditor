<UserControl x:Class="DeadEditor.Views.ConfirmHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="Collapsed">
    <!-- Bucket-B confirm host (alert-system-spec.md Ruling 2): a full-shell dimmed scrim + centered
         card. Silent by construction (no MessageBeep / SystemSounds, PullCollisionDialog precedent).
         Unlike the banner, the card OWNS keyboard focus by design — a blocking decision is the one
         surface that should take focus. The opaque scrim Border catches all mouse input, blocking
         interaction with the shell underneath; keyboard is gated by ShellWindow_PreviewKeyDown while
         this host IsShowing. Collapsed when idle. -->
    <UserControl.Resources>
        <!-- Self-contained dark theme (mirrors PullCollisionDialog) so the card reads correctly
             regardless of which view is behind the scrim. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Confirm is the consequential, default action — give it the accent fill. -->
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ScrimGrid" Background="#CC000000">
        <Border MinWidth="380" MaxWidth="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#252526"
                BorderBrush="#3C3C3C" BorderThickness="1"
                Padding="24">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="MessageText"
                           FontSize="14"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ConfirmButton"
                            MinWidth="100" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="ConfirmButton_Click"/>
                    <Button x:Name="CancelButton"
                            MinWidth="100"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
