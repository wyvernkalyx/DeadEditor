<UserControl x:Class="DeadEditor.Views.AlertBannerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False">
    <!-- In-window notification banner (alert-system-spec.md Ruling 1). Collapsed when idle; colors
         and label are set per-severity in code-behind. Silent by construction (no MessageBeep,
         no SystemSounds) and never calls Focus(), so showing it cannot steal keyboard focus. -->
    <Border x:Name="BannerBorder"
            Visibility="Collapsed"
            BorderThickness="0,0,0,1"
            Padding="16,10"
            Focusable="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SeverityLabel" Grid.Column="0"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <TextBlock x:Name="MessageText" Grid.Column="1"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <Button x:Name="CloseButton" Grid.Column="2"
                    Content="&#x2715;"
                    Width="28" Height="28"
                    Margin="12,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#DDDDDD"
                    FontSize="14"
                    Cursor="Hand"
                    IsTabStop="False"
                    Focusable="False"
                    ToolTip="Dismiss"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>
