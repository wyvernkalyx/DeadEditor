<UserControl x:Class="DeadEditor.MatchReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             MinWidth="640" MinHeight="360">
    <!-- Host-agnostic review surface (decision (a)): no DialogResult, no
         App.Alerts coupling. The host subscribes to Confirmed/Cancelled and
         reads ViewModel.BuildEditedProposalSet(). Self-contained dark theme
         mirrors the app's other dialogs. Render correctness is gated in the
         wiring step, not here. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Review Match Setlist changes"
                   FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                   Margin="0,0,0,12"/>

        <!-- One row per visible (non-no-op) proposal. Per-field Accept/Ignore. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VisibleRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#333333" BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Track number -->
                                <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                           Text="{Binding Track.DisplayTrackNumber}"
                                           Foreground="#888888" VerticalAlignment="Center"/>

                                <!-- SongName field: Old -> editable New, Accept checkbox -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <TextBlock Text="{Binding OldSongName}" Foreground="#999999"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  →  " Foreground="#666666"
                                               VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding EditableSongName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" Background="#2D2D30" Foreground="#FFFFFF"
                                             BorderBrush="#3F3F46" Padding="4,2"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Grid.Row="0" Content="Accept name"
                                          Foreground="#CCCCCC" VerticalAlignment="Center"
                                          Margin="12,0,0,4"
                                          IsChecked="{Binding IsSongNameAccepted}"/>

                                <!-- Segue field: Old -> New, Accept checkbox -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Segue: " Foreground="#999999"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OldSegue}" Foreground="#999999"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  →  " Foreground="#666666"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NewSegue}" Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Grid.Row="1" Content="Accept segue"
                                          Foreground="#CCCCCC" VerticalAlignment="Center"
                                          Margin="12,0,0,0"
                                          IsChecked="{Binding IsSegueAccepted}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Collapsed no-op count, shown only when there are hidden rows. -->
        <TextBlock Grid.Row="2" Text="{Binding HiddenSummary}"
                   Foreground="#888888" FontStyle="Italic" Margin="0,12,0,0"
                   Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Apply" Width="110" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="ConfirmButton_Click"/>
            <Button Content="Cancel" Width="110"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
