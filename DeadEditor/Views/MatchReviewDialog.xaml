<UserControl x:Class="DeadEditor.MatchReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             MinWidth="640" MinHeight="360">
    <!-- Host-agnostic review surface (decision (a)): no DialogResult, no
         App.Alerts coupling. The host subscribes to Confirmed/Cancelled and
         reads ViewModel.BuildEditedProposalSet(). Self-contained dark theme
         mirrors the app's other dialogs. Render correctness is gated in the
         wiring step, not here. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Review Match Setlist changes"
                   FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                   Margin="0,0,0,4"/>

        <!-- Legend: what the per-row checkboxes mean. Behavior-neutral. -->
        <TextBlock Grid.Row="1"
                   Text="Checked = use the setlist's value.  Unchecked = keep the current value."
                   Foreground="#9A9A9A" FontSize="12" Margin="0,0,0,12"/>

        <!-- One row per visible (non-no-op) proposal. Only the field(s) that
             actually changed are shown — a segue-only row carries no name
             control, and vice versa. Per-field Accept/Ignore. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VisibleRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#333333" BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <StackPanel>
                                <!-- Row header: the track's CURRENT identity, mirroring the
                                     album-detail grid behind the dialog (plain TrackNumber +
                                     DiscNumber, song title, duration) — never a setlist-derived
                                     or disc-concatenated number. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding TrackNumberDisplay}"
                                               Foreground="#C8C8C8" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrackTitleDisplay}"
                                               Foreground="#FFFFFF" FontWeight="SemiBold"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrackDurationDisplay}"
                                               Foreground="#888888"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Proposed change line(s), indented under the header -->
                                <StackPanel Margin="18,0,0,0">
                                    <!-- Name field: shown only when the name changed -->
                                    <Grid Margin="0,0,0,4"
                                          Visibility="{Binding SongNameChanged, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding OldSongName}" Foreground="#999999"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  →  " Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding EditableSongName, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="240" Background="#2D2D30" Foreground="#FFFFFF"
                                                     BorderBrush="#3F3F46" Padding="4,2"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Accept name"
                                                  Foreground="#CCCCCC" VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  IsChecked="{Binding IsSongNameAccepted}"/>
                                    </Grid>

                                    <!-- Segue field: shown only when the segue changed. Two
                                         source-labeled concrete values (Media vs Setlist), each with
                                         a trailing " >" when that side carries a segue, so the
                                         checkbox action reads against evidence rather than an
                                         abstract True -> False. -->
                                    <Grid Visibility="{Binding SegueChanged, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="200"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Column headers (dim, matching the legend/secondary typography) -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Media"
                                                       Foreground="#777777" FontSize="11" Margin="0,0,24,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Setlist"
                                                       Foreground="#777777" FontSize="11" Margin="0,0,0,2"/>
                                            <!-- Concrete values, each with its own " >" segue marker -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MediaDisplay}"
                                                       Foreground="#CFCFCF" Margin="0,0,24,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SetlistDisplay}"
                                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </Grid>
                                        <CheckBox Grid.Column="1" Content="{Binding SegueActionLabel}"
                                                  Foreground="#CCCCCC" VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  IsChecked="{Binding IsSegueAccepted}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Read-only Unmatched section: tracks the compute produced no proposal
             for (nothing to accept — resolved manually in the grid). Shown ABOVE
             the hidden "already match" line, gated by HasUnmatched. Header +
             stripped-down per-row identity mirroring the matched-row header, minus
             every accept/edit control. -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0"
                    Visibility="{Binding HasUnmatched, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding UnmatchedSummary}"
                       Foreground="#D8A24A" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding UnmatchedRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="18,2,0,2">
                            <TextBlock Text="{Binding TrackNumberDisplay}"
                                       Foreground="#C8C8C8" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TrackTitleDisplay}"
                                       Foreground="#FFFFFF"
                                       Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Collapsed no-op count, shown only when there are hidden rows. -->
        <TextBlock Grid.Row="4" Text="{Binding HiddenSummary}"
                   Foreground="#888888" FontStyle="Italic" Margin="0,12,0,0"
                   Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Apply" Width="110" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="ConfirmButton_Click"/>
            <Button Content="Cancel" Width="110"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
