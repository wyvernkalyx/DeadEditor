<UserControl x:Class="DeadEditor.EditSetlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#1E1E1E"
             Loaded="EditSetlistView_Loaded">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldStyle">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Metadata fields -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="VENUE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="VenueTextBox" Style="{StaticResource FieldStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="CITY, STATE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="CityStateTextBox" Style="{StaticResource FieldStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="DATE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="DateTextBox" Style="{StaticResource FieldStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddSongButton" Content="＋ Add Song"
                    Click="AddSongButton_Click"
                    Background="#3E3E42" Foreground="#CCCCCC"
                    BorderBrush="#555555" BorderThickness="1"
                    Padding="12,6" Cursor="Hand" FontSize="14"
                    Margin="0,0,8,0"/>
            <Button x:Name="NormalizeButton" Content="Normalize"
                    Click="NormalizeButton_Click"
                    Background="#3E3E42" Foreground="#CCCCCC"
                    BorderBrush="#555555" BorderThickness="1"
                    Padding="12,6" Cursor="Hand" FontSize="14"
                    Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text=""
                       Foreground="#888888" FontSize="14"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Row 2: Editable track grid -->
        <Border Grid.Row="2" BorderBrush="#555555" BorderThickness="1" Background="#1E1E1E">
            <DataGrid x:Name="TracksDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3F3F46"
                      Background="#1E1E1E"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#252526"
                      Foreground="#FFFFFF"
                      BorderThickness="0"
                      FontSize="16"
                      RowHeight="28"
                      SelectionMode="Extended"
                      CanUserSortColumns="False"
                      ColumnWidth="Auto"
                      HorizontalAlignment="Left"
                      PreviewKeyDown="TracksDataGrid_PreviewKeyDown"
                      CellEditEnding="TracksDataGrid_CellEditEnding">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#264F78"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Track # (read-only) -->
                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="Auto" MinWidth="40" IsReadOnly="True"/>

                    <!-- Song Name (display: "Song > (date)", edit: raw name) -->
                    <DataGridTemplateColumn Header="Song Name" Width="Auto" MinWidth="250" SortMemberPath="SongName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding SongName, Mode=OneWay}"/>
                                    <Run Text="{Binding SegueMarker, Mode=OneWay}" Foreground="#AAAAAA"/>
                                    <Run Text="{Binding DateDisplay, Mode=OneWay}" Foreground="#888888"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SongName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3C3C3C" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF"
                                         BorderBrush="#007ACC" BorderThickness="1"
                                         Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Segue (checkbox, matches Edit Metadata) -->
                    <DataGridCheckBoxColumn Header="&#x2192;" Binding="{Binding Segue, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="30">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>

                    <!-- Set -->
                    <DataGridComboBoxColumn Header="Set" SelectedItemBinding="{Binding Set, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="100">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 3: Status bar -->
        <TextBlock Grid.Row="3" x:Name="BottomStatusText" Text=""
                   Foreground="#888888" FontSize="13" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
