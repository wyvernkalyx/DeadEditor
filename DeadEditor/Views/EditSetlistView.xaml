<UserControl x:Class="DeadEditor.EditSetlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#1E1E1E"
             Loaded="EditSetlistView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldStyle">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Metadata fields -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="VENUE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="VenueTextBox" Style="{StaticResource FieldStyle}"
                         TextChanged="MetadataField_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="CITY, STATE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="CityStateTextBox" Style="{StaticResource FieldStyle}"
                         TextChanged="MetadataField_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="DATE" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="DateTextBox" Style="{StaticResource FieldStyle}"
                         TextChanged="MetadataField_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Action buttons (left) + verification surface (right) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="AddSongButton" Content="＋ Add Song"
                        Click="AddSongButton_Click"
                        Background="#3E3E42" Foreground="#CCCCCC"
                        BorderBrush="#555555" BorderThickness="1"
                        Padding="12,6" Cursor="Hand" FontSize="14"
                        Margin="0,0,8,0"/>
                <Button x:Name="NormalizeButton" Content="Normalize"
                        Click="NormalizeButton_Click"
                        Background="#3E3E42" Foreground="#CCCCCC"
                        BorderBrush="#555555" BorderThickness="1"
                        Padding="12,6" Cursor="Hand" FontSize="14"
                        Margin="0,0,8,0"/>
                <Button x:Name="CombineSelectedButton" Content="Combine Selected"
                        Click="CombineSelectedButton_Click"
                        Background="#3E3E42" Foreground="#CCCCCC"
                        BorderBrush="#555555" BorderThickness="1"
                        Padding="12,6" Cursor="Hand" FontSize="14"
                        Margin="0,0,8,0"
                        ToolTip="Select a contiguous run within one set, then combine it into an alias"/>
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#888888" FontSize="14"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Verification surface (spec decision 7): effectiveVerified badge + Mark-Verified
                 button + gate reason. Badge colours/text and button/reason visibility are driven
                 in code-behind by RefreshVerifyControls (Badge* brushes via FindResource); the
                 literals here are the unverified default. -->
            <StackPanel x:Name="VerifyActionSlot" Grid.Column="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="VerifyBadge" Padding="12,4" CornerRadius="3"
                            VerticalAlignment="Center" Background="#3C3C3C">
                        <TextBlock x:Name="VerifyBadgeText" Text="Unverified"
                                   Foreground="#888888" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="MarkVerifiedButton" Content="Mark Verified"
                            Margin="8,0,0,0" Height="26" Padding="10,2" FontSize="12"
                            VerticalAlignment="Center" Cursor="Hand"
                            Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                            Click="MarkVerifiedButton_Click"
                            ToolTip="Mark this concert as verified"/>
                    <!-- Unverify (spec decision 6, amended): low-emphasis secondary action shown
                         ONLY when the badge is verified; withdraws trust without an edit. Borderless
                         link-style so it doesn't compete with Save. Visibility driven in code-behind
                         by RefreshVerifyControls (mutually exclusive with Mark Verified). -->
                    <Button x:Name="UnverifyButton" Content="Unverify"
                            Margin="8,0,0,0" Height="26" Padding="6,2" FontSize="12"
                            VerticalAlignment="Center" Cursor="Hand"
                            Background="Transparent" Foreground="#888888" BorderThickness="0"
                            Visibility="Collapsed"
                            Click="UnverifyButton_Click"
                            ToolTip="Withdraw verification for this concert"/>
                </StackPanel>
                <TextBlock x:Name="VerifyReasonText" Visibility="Collapsed"
                           Margin="0,6,0,0" MaxWidth="260"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           TextWrapping="Wrap" FontSize="12" Foreground="#E74C3C"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Editable track grid -->
        <Border Grid.Row="2" BorderBrush="#555555" BorderThickness="1" Background="#1E1E1E">
            <DataGrid x:Name="TracksDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3F3F46"
                      Background="#1E1E1E"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#252526"
                      Foreground="#FFFFFF"
                      BorderThickness="0"
                      FontSize="16"
                      RowHeight="28"
                      SelectionMode="Extended"
                      CanUserSortColumns="False"
                      ColumnWidth="Auto"
                      HorizontalAlignment="Left"
                      PreviewKeyDown="TracksDataGrid_PreviewKeyDown"
                      CellEditEnding="TracksDataGrid_CellEditEnding">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#264F78"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Track # (read-only) -->
                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="Auto" MinWidth="40" IsReadOnly="True"/>

                    <!-- Song Name (display: "Song > (date)", edit: raw name) -->
                    <DataGridTemplateColumn Header="Song Name" Width="Auto" MinWidth="250" SortMemberPath="SongName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding SongName, Mode=OneWay}"/>
                                    <Run Text="{Binding SegueMarker, Mode=OneWay}" Foreground="#AAAAAA"/>
                                    <Run Text="{Binding DateDisplay, Mode=OneWay}" Foreground="#888888"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SongName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3C3C3C" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF"
                                         BorderBrush="#007ACC" BorderThickness="1"
                                         Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Segue (checkbox, matches Edit Metadata) -->
                    <DataGridCheckBoxColumn Header="&#x2192;" Binding="{Binding Segue, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="30">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>

                    <!-- Set -->
                    <DataGridComboBoxColumn Header="Set" SelectedItemBinding="{Binding Set, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="100">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 3: Status bar + COMBINED TRACKS section (recorded ✕ / staged-removal ↺ / pending-append ✕) -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="BottomStatusText" Text=""
                       Foreground="#888888" FontSize="13"/>

            <!-- Combine section: flows beneath the grid, left-aligned. Header + rows shown only when
                 recorded or pending combines exist (CombineSection.Visibility driven in code-behind
                 by RefreshAliasDisplay). Header + entry text match the read-only detail view's
                 COMBINED TRACKS treatment (16px SemiBold title, body-size entries). Each row is a
                 left-aligned horizontal run so the ✕/↺ control sits immediately after the entry text
                 rather than right-aligned across the row. -->
            <StackPanel x:Name="CombineSection"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="COMBINED TRACKS"
                           Foreground="#E0E0E0" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

            <!-- One row per combine. ✕ stages a recorded combine for removal / drops a pending append;
                 ↺ un-stages a removal. Controls disable (Q3) while structural edits are unsaved. -->
            <ItemsControl x:Name="AliasRowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,3,0,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="15"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPendingAppend}" Value="True">
                                                    <Setter Property="Foreground" Value="#777777"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStagedForRemoval}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="#6E6E6E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text=" (applies on Save)" FontSize="15"
                                           Foreground="#777777" VerticalAlignment="Center"
                                           Visibility="{Binding IsPendingAppend, Converter={StaticResource BoolToVis}}"/>

                            <Button VerticalAlignment="Center"
                                    Click="AliasRowActionButton_Click"
                                    Tag="{Binding}"
                                    Width="24" Height="22" Padding="0" FontSize="13"
                                    Cursor="Hand" Margin="8,0,0,0"
                                    Background="#3E3E42" Foreground="#CCCCCC"
                                    BorderBrush="#555555" BorderThickness="1"
                                    ToolTipService.ShowOnDisabled="True"
                                    IsEnabled="{Binding CombineControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="&#x2715;"/>
                                        <Setter Property="ToolTip" Value="Remove this combine"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStagedForRemoval}" Value="True">
                                                <Setter Property="Content" Value="&#x21BA;"/>
                                                <Setter Property="ToolTip" Value="Keep this combine (undo removal)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPendingAppend}" Value="True">
                                                <Setter Property="ToolTip" Value="Discard this staged combine"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CombineControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="ToolTip" Value="Save your setlist changes before editing combines."/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
