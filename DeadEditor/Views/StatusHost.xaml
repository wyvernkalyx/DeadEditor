<UserControl x:Class="DeadEditor.Views.StatusHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="Collapsed">
    <!-- Reusable modal "please wait" status overlay (alert-system-spec.md § Status overlay). A
         full-shell dimmed scrim + a centered card with an INDETERMINATE spinner, a title, and an
         optional message line, for long/blocking operations (the cold concert-database load; future
         media import). Same mold as ConfirmHost/ReadPanelHost (scrim + dark card, silent by
         construction — no MessageBeep / SystemSounds / OS chrome) but it is NON-CANCELABLE: no
         buttons, no Esc, no result. The shell swallows every key while it is showing. Collapsed when
         idle; the spinner storyboard runs only while shown (Begin on ShowStatus, Stop on HideStatus). -->
    <UserControl.Resources>
        <!-- Indeterminate spinner: a single accent arc rotating over a faint track ring. Controlled
             from code (Begin/Stop) so it spins only while the overlay is up. -->
        <Storyboard x:Key="SpinnerStoryboard">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <!-- Full-bleed scrim — matches ConfirmHost/ReadPanelHost exactly (#CC000000). -->
    <Grid x:Name="ScrimGrid" Background="#CC000000">
        <Border MinWidth="320" MaxWidth="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#2D2D30"
                BorderBrush="#3F3F46" BorderThickness="0.5"
                CornerRadius="12"
                Padding="40,32">
            <StackPanel HorizontalAlignment="Center">
                <!-- Indeterminate ring: faint full track + a rotating accent arc (StrokeDashArray
                     draws ~a quarter of the circumference, then a gap; the RotateTransform spins it).
                     Indeterminate only — no determinate/percent this commit. -->
                <Grid Width="44" Height="44" Margin="0,0,0,22">
                    <Ellipse Stroke="#3F3F46" StrokeThickness="4"/>
                    <Ellipse x:Name="Spinner"
                             Stroke="#1177BB" StrokeThickness="4"
                             StrokeDashCap="Round"
                             StrokeDashArray="7.85 23.55"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="TitleText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#E0E0E0"
                           TextAlignment="Center" TextWrapping="Wrap"/>

                <!-- Message line: Collapsed when null/empty (SetMessage); shown when supplied. -->
                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           Foreground="#888888"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
