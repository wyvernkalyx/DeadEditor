<UserControl x:Class="DeadEditor.AlbumDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DeadEditor.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1E1E1E"
             Loaded="AlbumDetailView_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Album Art + Metadata -->
        <StackPanel Grid.Column="0">
            <!-- Album Art -->
            <Grid Width="180" Height="180">
                <!-- Actual album art image -->
                <Image x:Name="AlbumArtImage"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <!-- Placeholder (shown when no artwork) -->
                <Border x:Name="ArtworkPlaceholder"
                        Background="#2D2D30"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Visibility="Visible">
                    <TextBlock Text="🎵"
                               FontSize="60"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Metadata -->
            <TextBlock x:Name="VenueText" Text="Venue / Album"
                       Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"
                       Margin="0,12,0,6" TextWrapping="Wrap"/>

            <TextBlock x:Name="LocationText" Text="Location / Year"
                       Foreground="#CCCCCC" FontSize="15"
                       Margin="0,0,0,6" TextWrapping="Wrap"/>

            <TextBlock x:Name="DateText" Text="Date"
                       Foreground="#CCCCCC" FontSize="15"
                       Margin="0,0,0,6"/>

            <TextBlock x:Name="TrackCountText" Text="0 tracks"
                       Foreground="#999999" FontSize="14"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Right: Track List -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="TRACKS"
                       Foreground="#CCCCCC" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <DataGrid Grid.Row="1"
                      x:Name="TracksDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="#252526"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D30"
                      Foreground="#CCCCCC"
                      BorderThickness="0"
                      MouseLeftButtonUp="TracksDataGrid_MouseLeftButtonUp"
                      MouseDoubleClick="TracksDataGrid_MouseDoubleClick">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Track Number Column - shows chevron for headers, number for tracks -->
                    <DataGridTemplateColumn Header="#" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#1A1A2E" BorderBrush="#D7BA7D" BorderThickness="3,0,0,0" MinHeight="40" Padding="16,0,0,0">
                                                <TextBlock Text="{Binding ChevronIcon}"
                                                           FontWeight="Bold"
                                                           FontSize="18"
                                                           Foreground="#FFFFFF"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <TextBlock Text="{Binding Track.TrackNumber}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <TextBlock Text="{Binding TrackNumber}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Title Column - shows date + track count + Add All for headers, track title for tracks -->
                    <DataGridTemplateColumn Header="Title" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#1A1A2E" MinHeight="40" Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Date}"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               Foreground="#FFFFFF"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,24,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TrackCount, StringFormat='{}{0} tracks'}"
                                                               FontSize="14"
                                                               Foreground="#CCCCCC"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3"
                                                            Content="＋ Add All"
                                                            Click="AddAllTracksButton_Click"
                                                            Tag="{Binding Date}"
                                                            Background="#2D2D30"
                                                            Foreground="#FFFFFF"
                                                            BorderBrush="#555555"
                                                            BorderThickness="1"
                                                            Padding="12,6"
                                                            Margin="0,0,12,0"
                                                            FontSize="13"
                                                            Cursor="Hand"
                                                            MinHeight="32"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <TextBlock Text="{Binding Track.Title}" FontSize="16" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <TextBlock Text="{Binding Title}" FontSize="16" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Duration Column - empty for headers, duration for tracks -->
                    <DataGridTemplateColumn Header="Duration" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#1A1A2E" MinHeight="40" Padding="0"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <TextBlock Text="{Binding Track.Duration}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <TextBlock Text="{Binding Duration}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
