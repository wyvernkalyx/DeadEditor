<UserControl x:Class="DeadEditor.AlbumDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DeadEditor.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1E1E1E"
             Loaded="AlbumDetailView_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Album Art + Metadata -->
        <StackPanel Grid.Column="0">
            <!-- Album Art -->
            <Grid Width="180" Height="180">
                <!-- Actual album art image -->
                <Image x:Name="AlbumArtImage"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <!-- Placeholder (shown when no artwork) -->
                <Border x:Name="ArtworkPlaceholder"
                        Background="#2D2D30"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Visibility="Visible">
                    <TextBlock Text="🎵"
                               FontSize="60"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Metadata -->
            <TextBlock x:Name="AlbumNameDetailText" Text=""
                       Foreground="#E0E0E0" FontSize="20" FontWeight="Bold"
                       Margin="0,12,0,6" TextWrapping="Wrap"/>

            <TextBlock x:Name="VenueText" Text="Venue / Album"
                       Foreground="#CCCCCC" FontSize="15"
                       Margin="0,0,0,6" TextWrapping="Wrap"/>

            <TextBlock x:Name="LocationText" Text="Location / Year"
                       Foreground="#E0E0E0" FontSize="15"
                       Margin="0,0,0,6" TextWrapping="Wrap"/>

            <TextBlock x:Name="DateText" Text="Date"
                       Foreground="#E0E0E0" FontSize="15"
                       Margin="0,0,0,6"/>

            <TextBlock x:Name="TrackCountText" Text="0 tracks"
                       Foreground="#888888" FontSize="14"
                       Margin="0,10,0,0"/>

            <TextBlock x:Name="HeadyCountText"
                       Foreground="#D4A017" FontSize="13"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="JerrybaseLink"
                       Text="Jerrybase ↗"
                       Foreground="#5B9BD5" FontSize="13"
                       Margin="0,8,0,0"
                       Cursor="Hand"
                       Visibility="Collapsed"
                       MouseLeftButtonUp="JerrybaseLink_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Right: Track List -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="TRACKS"
                           Foreground="#E0E0E0" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button x:Name="ExpandAllButton" Content="Expand All"
                        Click="ExpandAllButton_Click"
                        Background="Transparent" Foreground="#888888" BorderThickness="0"
                        Padding="8,4" Margin="16,0,0,0" FontSize="13" Cursor="Hand"
                        Visibility="Collapsed" VerticalAlignment="Center"/>

                <Button x:Name="CollapseAllButton" Content="Collapse All"
                        Click="CollapseAllButton_Click"
                        Background="Transparent" Foreground="#888888" BorderThickness="0"
                        Padding="8,4" Margin="4,0,0,0" FontSize="13" Cursor="Hand"
                        Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      x:Name="TracksDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="#252526"
                      RowBackground="#252526"
                      AlternatingRowBackground="#2D2D30"
                      Foreground="#CCCCCC"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      MouseLeftButtonUp="TracksDataGrid_MouseLeftButtonUp"
                      MouseDoubleClick="TracksDataGrid_MouseDoubleClick"
                      MouseRightButtonUp="TracksDataGrid_MouseRightButtonUp"
                      Sorting="TracksDataGrid_Sorting"
                      CanUserSortColumns="True">

                <DataGrid.Resources>
                    <!-- Override WPF system selection colors -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#37373D"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2A2D3E"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="MinHeight" Value="38"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Track Number Column - shows chevron for headers, number for tracks -->
                    <DataGridTemplateColumn Header="#" Width="Auto" MinWidth="40" SortMemberPath="TrackNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#2A2D3E" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" MinHeight="44" Padding="12,0,0,0" Margin="-6,0,-18,0">
                                                <TextBlock Text="{Binding ChevronIcon}"
                                                           FontWeight="Bold"
                                                           FontSize="18"
                                                           Foreground="#E0E0E0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <TextBlock Text="{Binding Track.TrackNumber}" FontSize="15" Foreground="#888888" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <TextBlock Text="{Binding TrackNumber}" FontSize="15" Foreground="#888888" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Title Column - shows date + track count + Add All for headers, track title for tracks -->
                    <DataGridTemplateColumn Header="Title" Width="Auto" MinWidth="250" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#2A2D3E" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" MinHeight="44" Padding="0" Margin="-18,0,-18,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding HeaderText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="18"
                                                               Foreground="#E0E0E0"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,20,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TrackCount, StringFormat='{}{0} tracks'}"
                                                               FontSize="15"
                                                               Foreground="#888888"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3"
                                                            Content="＋ Add All"
                                                            Click="AddAllTracksButton_Click"
                                                            Tag="{Binding Date}"
                                                            Background="Transparent"
                                                            Foreground="#E0E0E0"
                                                            BorderBrush="#3E3E42"
                                                            BorderThickness="1"
                                                            Padding="10,5"
                                                            Margin="0,0,10,0"
                                                            FontSize="13"
                                                            Cursor="Hand"
                                                            MinHeight="28"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    Padding="{TemplateBinding Padding}"
                                                                                    CornerRadius="3">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Track.HeadyIcon}"
                                                           ToolTip="{Binding Track.HeadyTooltip}"
                                                           Tag="{Binding Track.HeadyUrl}"
                                                           MouseLeftButtonUp="HeadyIcon_Click"
                                                           FontSize="15" Foreground="#D4A017"
                                                           Cursor="Hand" Margin="0,0,5,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Track.Title}" FontSize="15" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HeadyIcon}"
                                                           ToolTip="{Binding HeadyTooltip}"
                                                           Tag="{Binding HeadyUrl}"
                                                           MouseLeftButtonUp="HeadyIcon_Click"
                                                           FontSize="15" Foreground="#D4A017"
                                                           Cursor="Hand" Margin="0,0,5,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" FontSize="15" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Duration Column - empty for headers, duration for tracks -->
                    <DataGridTemplateColumn Header="Duration" Width="Auto" MinWidth="60" SortMemberPath="Duration">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:DateHeaderItem}">
                                            <Border Background="#2A2D3E" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" MinHeight="44" Padding="0" Margin="-18,0,-6,0"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackViewItem}">
                                            <TextBlock Text="{Binding Track.Duration}" FontSize="15" Foreground="#888888" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type models:TrackInfo}">
                                            <TextBlock Text="{Binding Duration}" FontSize="15" Foreground="#888888" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
