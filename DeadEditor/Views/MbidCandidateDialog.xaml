<Window x:Class="DeadEditor.Views.MbidCandidateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select MusicBrainz Release" Height="650" Width="750"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Album info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Select Release for Album" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
            <TextBlock x:Name="AlbumInfoText" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap"/>
            <TextBlock x:Name="WarningText" FontSize="13" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Candidates list with radio buttons -->
        <TextBlock Grid.Row="1" Text="Candidates:" FontSize="14" FontWeight="SemiBold" Foreground="#569CD6" Margin="0,0,0,6"/>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CandidatesPanel" Margin="8"/>
            </ScrollViewer>
        </Border>

        <!-- Manual MBID entry -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Or enter MBID manually:" FontSize="13" Foreground="#999999" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ManualRadio" GroupName="CandidateGroup" VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ManualRadio_Checked"/>
                <TextBox x:Name="ManualMbidTextBox" Grid.Column="1" Height="32" FontSize="13"
                         Background="#333333" Foreground="#E0E0E0" BorderBrush="#3E3E42"
                         Padding="6,4" VerticalContentAlignment="Center"
                         TextChanged="ManualMbidTextBox_TextChanged"/>
            </Grid>
            <TextBlock x:Name="ManualValidationText" FontSize="12" Foreground="#FF6666" Margin="24,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Fields to apply panel (visible only when showFieldCheckboxes is true and a candidate is selected) -->
        <Border Grid.Row="4" x:Name="FieldsToApplyPanel" Visibility="Collapsed"
                Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3"
                Margin="0,12,0,0" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Fields to apply" FontSize="13" FontWeight="SemiBold" Foreground="#569CD6" Margin="0,0,0,6"/>
                <CheckBox x:Name="ApplyMbidCheckBox" Content="Release MBID (always applied)" IsChecked="True" IsEnabled="False"
                          Foreground="#CCCCCC" FontSize="13" Margin="0,2"/>
                <CheckBox x:Name="ApplyAlbumTitleCheckBox" Foreground="#CCCCCC" FontSize="13" Margin="0,2" Visibility="Collapsed"/>
                <CheckBox x:Name="ApplyAlbumArtistCheckBox" Foreground="#CCCCCC" FontSize="13" Margin="0,2" Visibility="Collapsed"/>
                <CheckBox x:Name="ApplyReleaseYearCheckBox" Foreground="#CCCCCC" FontSize="13" Margin="0,2" Visibility="Collapsed"/>
                <CheckBox x:Name="ApplyTrackTitlesCheckBox" Content="Track titles (applies to matching positions)"
                          Foreground="#CCCCCC" FontSize="13" Margin="0,2"/>
                <TextBlock Text="Only checked fields will be applied.&#x0a;Click Save in Edit Metadata to commit changes to disk."
                           FontSize="11" Foreground="#777777" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Skip" Width="100" Height="36"
                    Background="#3C3C3C" Foreground="#FFFFFF"
                    FontSize="14" BorderThickness="0" Cursor="Hand"
                    Click="SkipButton_Click" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="ConfirmButton" Content="Confirm" Width="120" Height="36"
                    Background="#2D5F2D" Foreground="#FFFFFF"
                    FontSize="14" BorderThickness="0" Cursor="Hand"
                    Click="ConfirmButton_Click" IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A7A3A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
