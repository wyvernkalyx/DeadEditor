<Window x:Class="DeadEditor.MatchReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeadEditor"
        Title="Review Match Setlist Changes"
        Height="600" Width="820"
        MinHeight="420" MinWidth="680"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <!-- Thin host for the host-agnostic MatchReviewDialog UserControl (commit-1
         decision (a)). The Window is the host: it owns DialogResult and maps the
         control's Confirmed/Cancelled events onto it. The UserControl itself
         carries no DialogResult coupling. -->
    <local:MatchReviewDialog x:Name="ReviewDialog"/>
</Window>
