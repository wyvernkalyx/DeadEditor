<UserControl x:Class="DeadEditor.BoxSetWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Local styles cloned from EditSetlistView.xaml:11-26 so the wizard's form
             matches the setlist editor's look without introducing a shared dictionary. -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldStyle">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Step indicator strip -->
            <RowDefinition Height="*"/>     <!-- Step content -->
        </Grid.RowDefinitions>

        <!-- Step indicator: "Step N of 4 — Title" -->
        <Border Grid.Row="0" Background="#252526" Padding="20,12"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <TextBlock x:Name="StepIndicatorText"
                       Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- Step content: four panels stacked in the same Grid cell, only one visible at a time. -->
        <Grid Grid.Row="1" Margin="20,16">

            <!-- ===== STEP 1 — Top-Level Info ===== -->
            <ScrollViewer x:Name="Step1Content" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="NAME *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource FieldStyle}"
                             Width="400" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="RELEASE DATE *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ReleaseDateTextBox" Style="{StaticResource FieldStyle}"
                             Width="160" HorizontalAlignment="Left"
                             Margin="0,0,0,16" ToolTip="yyyy-MM-dd"/>

                    <TextBlock Text="LABEL" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="LabelTextBox" Style="{StaticResource FieldStyle}"
                             Width="320" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="CATALOG NUMBER" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CatalogNumberTextBox" Style="{StaticResource FieldStyle}"
                             Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="NOTES" Style="{StaticResource LabelStyle}"/>
                    <!-- FieldStyle hard-sets Height=34 which clips multi-line. Inline the
                         same setters minus the Height for this one field. -->
                    <TextBox x:Name="NotesTextBox"
                             Background="#3C3C3C" Foreground="#FFFFFF" BorderBrush="#555555"
                             CaretBrush="#FFFFFF" Padding="8,6" FontSize="15"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             Width="500" HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <TextBlock x:Name="ValidationMessage"
                               Foreground="#E74C3C" FontSize="14"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== STEP 2 — Concerts ===== -->
            <Grid x:Name="Step2Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left pane: concert list + add/remove -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="CONCERTS" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="AddConcertButton" Content="+ Add"
                                Click="AddConcertButton_Click"
                                Padding="8,4" Cursor="Hand"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>
                        <Button x:Name="RemoveConcertButton" Content="− Remove"
                                Click="RemoveConcertButton_Click"
                                Padding="8,4" Cursor="Hand" Margin="8,0,0,0"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>
                    </StackPanel>

                    <ListBox x:Name="ConcertListBox"
                             SelectionChanged="ConcertListBox_SelectionChanged"
                             Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                             Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}"
                                           FontSize="14" Padding="4,4"
                                           Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Right pane: detail form (shown when a concert is selected) -->
                <ScrollViewer Grid.Column="1" x:Name="ConcertDetailScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="ConcertDetailPanel">
                        <TextBlock Text="DATE *" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Date, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"
                                 ToolTip="yyyy-MM-dd"/>

                        <TextBlock Text="VENUE" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Venue, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="CITY" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="240" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="STATE" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding State, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="COUNTRY" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Country, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <TextBlock Text="Tracks — rebuilt in commit G"
                                   Foreground="#888888" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty-state: shown when no concert is selected -->
                <TextBlock Grid.Column="1" x:Name="NoConcertSelectedText"
                           Text="Select a concert from the list, or click + Add to create one"
                           Foreground="#888888" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- ===== STEP 3 — Discs (placeholder; real content in commit 4b) ===== -->
            <TextBlock x:Name="Step3Content" Visibility="Collapsed"
                       Text="Step 3 — Discs (coming next commit)"
                       Foreground="#888888" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ===== STEP 4 — Review (placeholder; real content in commit 4c) ===== -->
            <TextBlock x:Name="Step4Content" Visibility="Collapsed"
                       Text="Step 4 — Review (coming next commit). Clicking Save will write the definition with the step-1 fields and empty concerts/discs."
                       Foreground="#888888" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
