<UserControl x:Class="DeadEditor.BoxSetWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:DeadEditor.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Date-group header text (date + derived venue + track count), commit H. -->
        <conv:GroupHeaderConverter x:Key="GroupHeaderConverter"/>

        <!-- Accordion: drives each group Expander's IsExpanded from ActiveGroupDate (commit H2). -->
        <conv:GroupActiveConverter x:Key="GroupActiveConverter"/>

        <!-- Local styles cloned from EditSetlistView.xaml:11-26 so the wizard's form
             matches the setlist editor's look without introducing a shared dictionary. -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldStyle">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Step indicator strip -->
            <RowDefinition Height="*"/>     <!-- Step content -->
        </Grid.RowDefinitions>

        <!-- Step indicator: "Step N of 3 — Title" -->
        <Border Grid.Row="0" Background="#252526" Padding="20,12"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <TextBlock x:Name="StepIndicatorText"
                       Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- Step content: four panels stacked in the same Grid cell, only one visible at a time. -->
        <Grid Grid.Row="1" Margin="20,16">

            <!-- ===== STEP 1 — Top-Level Info ===== -->
            <ScrollViewer x:Name="Step1Content" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="NAME *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource FieldStyle}"
                             Width="400" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="RELEASE DATE *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ReleaseDateTextBox" Style="{StaticResource FieldStyle}"
                             Width="160" HorizontalAlignment="Left"
                             Margin="0,0,0,16" ToolTip="yyyy-MM-dd"/>

                    <TextBlock Text="LABEL" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="LabelTextBox" Style="{StaticResource FieldStyle}"
                             Width="320" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="CATALOG NUMBER" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CatalogNumberTextBox" Style="{StaticResource FieldStyle}"
                             Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="NOTES" Style="{StaticResource LabelStyle}"/>
                    <!-- FieldStyle hard-sets Height=34 which clips multi-line. Inline the
                         same setters minus the Height for this one field. -->
                    <TextBox x:Name="NotesTextBox"
                             Background="#3C3C3C" Foreground="#FFFFFF" BorderBrush="#555555"
                             CaretBrush="#FFFFFF" Padding="8,6" FontSize="15"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             Width="500" HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <TextBlock x:Name="ValidationMessage"
                               Foreground="#E74C3C" FontSize="14"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== STEP 2 — Concerts and Tracks (editable flat track grid, commit G2) ===== -->
            <Grid x:Name="Step2Content" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Add control -->
                    <RowDefinition Height="*"/>     <!-- Track grid -->
                </Grid.RowDefinitions>

                <!-- Row 0: bulk-entry actions. Add (Delete is via the Del key, matching
                     EditSetlistView); and a "pull setlist for date" action that appends one
                     track per song from the gdshowsdb reference setlist (commit G3). -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="AddTrackButton" Content="＋ Add Track"
                            Click="AddTrackButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Padding="12,6" Cursor="Hand" FontSize="14"/>

                    <!-- Separator + pull control, distinct from Add as a second bulk action. -->
                    <Border Width="1" Background="#555555" Margin="16,2,16,2"/>

                    <TextBlock Text="Pull setlist:" Foreground="#999999" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PullDateTextBox"
                             Background="#3C3C3C" Foreground="#FFFFFF" BorderBrush="#555555"
                             CaretBrush="#FFFFFF" Padding="6,4" FontSize="14"
                             Width="120" VerticalContentAlignment="Center"
                             ToolTip="yyyy-MM-dd" Margin="0,0,8,0"/>
                    <Button x:Name="PullSetlistButton" Content="Pull"
                            Click="PullSetlistButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Padding="12,6" Cursor="Hand" FontSize="14"/>

                    <!-- Renumber: third bulk action. Re-sequences TrackNumber to 1..N by date
                         (no-date last); fixes out-of-order pulls and closes delete gaps. -->
                    <Border Width="1" Background="#555555" Margin="16,2,16,2"/>
                    <Button x:Name="RenumberButton" Content="Renumber"
                            Click="RenumberButton_Click"
                            Background="#3E3E42" Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Padding="12,6" Cursor="Hand" FontSize="14"
                            ToolTip="Renumber tracks 1…N by date"/>

                    <!-- Group/flat toggle (commit H); default grouped. -->
                    <Border Width="1" Background="#555555" Margin="16,2,16,2"/>
                    <CheckBox x:Name="GroupByDateCheckBox" Content="Group by date"
                              IsChecked="True"
                              Checked="GroupByDateCheckBox_Changed"
                              Unchecked="GroupByDateCheckBox_Changed"
                              Foreground="#CCCCCC" FontSize="14"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 1: Editable track grid (cloned from EditSetlistView.xaml; simpler — no
                     song/date adornment, no Set combo). -->
                <Border Grid.Row="1" BorderBrush="#555555" BorderThickness="1" Background="#1E1E1E">
                    <DataGrid x:Name="TracksDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3F3F46"
                              Background="#1E1E1E"
                              RowBackground="#1E1E1E"
                              AlternatingRowBackground="#252526"
                              Foreground="#FFFFFF"
                              BorderThickness="0"
                              FontSize="16"
                              RowHeight="28"
                              SelectionMode="Extended"
                              CanUserSortColumns="False"
                              ColumnWidth="Auto"
                              HorizontalAlignment="Left"
                              PreviewKeyDown="TracksDataGrid_PreviewKeyDown"
                              CellEditEnding="TracksDataGrid_CellEditEnding">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#264F78"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <!-- Date grouping (commit H): collapsible per-date headers. The
                             Expander defaults collapsed (all groups closed; auto-expanding
                             the most-recent group is H2). Header = date + venue + count via
                             GroupHeaderConverter. First grouped grid in the app. -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <!-- Accordion (commit H2): IsExpanded is true only for the
                                                         single active group. MultiBinding over [group date key,
                                                         ActiveGroupDate]; Mode=OneWay is REQUIRED because
                                                         Expander.IsExpanded BindsTwoWayByDefault — a two-way bind
                                                         would invoke the converter's (throwing) ConvertBack on a
                                                         user header-click. ActiveGroupDate reached via the
                                                         UserControl ancestor. -->
                                                    <Expander Background="#252526"
                                                              BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                                                              Foreground="#CCCCCC" Margin="0,2,0,0">
                                                        <Expander.IsExpanded>
                                                            <MultiBinding Converter="{StaticResource GroupActiveConverter}" Mode="OneWay">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="ActiveGroupDate"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                            </MultiBinding>
                                                        </Expander.IsExpanded>
                                                        <!-- Header: derived "date — venue (N tracks)" text on the left,
                                                             a flat ✕ "remove this date" button docked right (commit H3).
                                                             The button's DataContext is this group's CollectionViewGroup,
                                                             so RemoveDateButton_Click reads its .Name (the date key). -->
                                                        <Expander.Header>
                                                            <DockPanel LastChildFill="True">
                                                                <Button DockPanel.Dock="Right"
                                                                        Click="RemoveDateButton_Click"
                                                                        Content="&#x2715;"
                                                                        ToolTip="Remove this date"
                                                                        Width="20" Height="20" Padding="0"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Foreground="#CCCCCC" Cursor="Hand"
                                                                        VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                                <TextBlock Text="{Binding Converter={StaticResource GroupHeaderConverter}}"
                                                                           Foreground="#CCCCCC" FontWeight="SemiBold"
                                                                           FontSize="14" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <!-- Track # — editable (curator renumbers to match the physical release).
                                 Non-integer input reverts via WPF int-binding default. -->
                            <DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="Auto" MinWidth="60"/>

                            <!-- Song Name — plain editable text, free-form (no normalization in G2). -->
                            <DataGridTextColumn Header="Song Name"
                                                Binding="{Binding SongName, UpdateSourceTrigger=PropertyChanged}"
                                                Width="Auto" MinWidth="300">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Date — editable; per-track yyyy-MM-dd validated on Save (empty allowed). -->
                            <DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding Date}" Width="Auto" MinWidth="120">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Segue — checkbox bound to SegueOut. -->
                            <DataGridCheckBoxColumn Header="Segue" Binding="{Binding SegueOut, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="60">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ===== STEP 3 — Review (read-only summary of the box set) ===== -->
            <ScrollViewer x:Name="Step3Content" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                    <!-- Header row: box name (left) + reserved verify slot (right) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReviewNameText" Grid.Column="0"
                                   Foreground="#E0E0E0" FontSize="20" FontWeight="Bold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <!-- commit 3: Mark-Verified button + effectiveVerified badge (Badge* brushes) -->
                        <StackPanel x:Name="VerifyActionSlot" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Release date -->
                    <TextBlock Text="RELEASE DATE" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="ReviewReleaseDateText"
                               Foreground="#FFFFFF" FontSize="15" Margin="0,0,0,16"/>

                    <!-- Label / Catalog (whole section collapsed when both are blank) -->
                    <StackPanel x:Name="ReviewLabelCatalogSection">
                        <TextBlock Text="LABEL / CATALOG" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="ReviewLabelCatalogText"
                                   Foreground="#E0E0E0" FontSize="15" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Track summary: count lead line + one read-only line per date -->
                    <TextBlock x:Name="ReviewTrackCountText"
                               Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel x:Name="ReviewDatesPanel" Margin="0,0,0,16"/>

                    <!-- Notes (collapsed when empty) -->
                    <StackPanel x:Name="ReviewNotesSection">
                        <TextBlock Text="NOTES" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="ReviewNotesText"
                                   Foreground="#E0E0E0" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
