<UserControl x:Class="DeadEditor.BoxSetWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Local styles cloned from EditSetlistView.xaml:11-26 so the wizard's form
             matches the setlist editor's look without introducing a shared dictionary. -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldStyle">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Step indicator strip -->
            <RowDefinition Height="*"/>     <!-- Step content -->
        </Grid.RowDefinitions>

        <!-- Step indicator: "Step N of 4 — Title" -->
        <Border Grid.Row="0" Background="#252526" Padding="20,12"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <TextBlock x:Name="StepIndicatorText"
                       Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- Step content: four panels stacked in the same Grid cell, only one visible at a time. -->
        <Grid Grid.Row="1" Margin="20,16">

            <!-- ===== STEP 1 — Top-Level Info ===== -->
            <ScrollViewer x:Name="Step1Content" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="NAME *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource FieldStyle}"
                             Width="400" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="RELEASE DATE *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ReleaseDateTextBox" Style="{StaticResource FieldStyle}"
                             Width="160" HorizontalAlignment="Left"
                             Margin="0,0,0,16" ToolTip="yyyy-MM-dd"/>

                    <TextBlock Text="LABEL" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="LabelTextBox" Style="{StaticResource FieldStyle}"
                             Width="320" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="CATALOG NUMBER" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CatalogNumberTextBox" Style="{StaticResource FieldStyle}"
                             Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="NOTES" Style="{StaticResource LabelStyle}"/>
                    <!-- FieldStyle hard-sets Height=34 which clips multi-line. Inline the
                         same setters minus the Height for this one field. -->
                    <TextBox x:Name="NotesTextBox"
                             Background="#3C3C3C" Foreground="#FFFFFF" BorderBrush="#555555"
                             CaretBrush="#FFFFFF" Padding="8,6" FontSize="15"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             Width="500" HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="DISC COUNT *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DiscCountTextBox" Style="{StaticResource FieldStyle}"
                             Width="80" HorizontalAlignment="Left" Margin="0,0,0,16"
                             ToolTip="1-99"/>

                    <TextBlock x:Name="ValidationMessage"
                               Foreground="#E74C3C" FontSize="14"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== STEP 2 — Concerts ===== -->
            <Grid x:Name="Step2Content" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left pane: concert list + add/remove -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="CONCERTS" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="AddConcertButton" Content="+ Add"
                                Click="AddConcertButton_Click"
                                Padding="8,4" Cursor="Hand"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>
                        <Button x:Name="RemoveConcertButton" Content="− Remove"
                                Click="RemoveConcertButton_Click"
                                Padding="8,4" Cursor="Hand" Margin="8,0,0,0"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>
                    </StackPanel>

                    <ListBox x:Name="ConcertListBox"
                             SelectionChanged="ConcertListBox_SelectionChanged"
                             Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                             Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}"
                                           FontSize="14" Padding="4,4"
                                           Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Right pane: detail form (shown when a concert is selected) -->
                <ScrollViewer Grid.Column="1" x:Name="ConcertDetailScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="ConcertDetailPanel">
                        <TextBlock Text="DATE *" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Date, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"
                                 ToolTip="yyyy-MM-dd"/>

                        <TextBlock Text="VENUE" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Venue, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="CITY" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="240" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="STATE" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding State, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBlock Text="COUNTRY" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Country, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FieldStyle}"
                                 Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <Separator Margin="0,8,0,12" Background="#3F3F46"/>

                        <TextBlock Text="SETLIST" Style="{StaticResource LabelStyle}"/>

                        <!-- Setlist: ItemsControl over BoxSetSetVm; each item renders as a
                             bordered group containing a song ItemsControl + per-set actions. -->
                        <ItemsControl ItemsSource="{Binding Setlist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2A2D" BorderBrush="#3F3F46"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Set header: "Set <name>" + Normalize + Remove -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Set" VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               Foreground="#AAAAAA" FontWeight="SemiBold"/>
                                                    <TextBox Text="{Binding Set, UpdateSourceTrigger=LostFocus}"
                                                             Width="120"
                                                             Background="#3C3C3C" Foreground="#FFFFFF"
                                                             CaretBrush="#FFFFFF" BorderBrush="#555555"
                                                             Padding="6,3"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Normalize" Tag="{Binding}"
                                                            Click="NormalizeSetButton_Click"
                                                            Padding="8,4" Margin="0,0,8,0" Cursor="Hand"
                                                            Background="#3E3E42" Foreground="#CCCCCC"
                                                            BorderBrush="#555555"
                                                            ToolTip="Run fuzzy match against songs.json for every song in this set"/>
                                                    <Button Content="− Remove Set" Tag="{Binding}"
                                                            Click="RemoveSetButton_Click"
                                                            Padding="8,4" Cursor="Hand"
                                                            Background="#3E3E42" Foreground="#CCCCCC"
                                                            BorderBrush="#555555"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Song rows: ItemsControl (not DataGrid) for always-
                                                 editable TextBoxes without the click-to-edit dance. -->
                                            <ItemsControl ItemsSource="{Binding Songs}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                     Background="#3C3C3C" Foreground="#FFFFFF"
                                                                     CaretBrush="#FFFFFF" BorderBrush="#555555"
                                                                     Padding="6,4"/>

                                                            <CheckBox Grid.Column="1"
                                                                      IsChecked="{Binding SegueOut, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="Segue out"/>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        Margin="6,0,0,0">
                                                                <Button Content="▲" Tag="{Binding}"
                                                                        Click="MoveSongUpButton_Click"
                                                                        Width="22" Height="22" Padding="0"
                                                                        Margin="2,0,0,0" Cursor="Hand"
                                                                        Background="#3E3E42" Foreground="#CCCCCC"
                                                                        BorderBrush="#555555"
                                                                        ToolTip="Move up"/>
                                                                <Button Content="▼" Tag="{Binding}"
                                                                        Click="MoveSongDownButton_Click"
                                                                        Width="22" Height="22" Padding="0"
                                                                        Margin="2,0,0,0" Cursor="Hand"
                                                                        Background="#3E3E42" Foreground="#CCCCCC"
                                                                        BorderBrush="#555555"
                                                                        ToolTip="Move down"/>
                                                                <Button Content="✕" Tag="{Binding}"
                                                                        Click="RemoveSongButton_Click"
                                                                        Width="22" Height="22" Padding="0"
                                                                        Margin="2,0,0,0" Cursor="Hand"
                                                                        Background="#3E3E42" Foreground="#CC6666"
                                                                        BorderBrush="#663333"
                                                                        ToolTip="Remove"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="+ Add Song" Tag="{Binding}"
                                                    Click="AddSongButton_Click"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Padding="8,4" Cursor="Hand"
                                                    Background="#3E3E42" Foreground="#CCCCCC"
                                                    BorderBrush="#555555"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="AddSetButton" Content="+ Add Set"
                                Click="AddSetButton_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Padding="10,6" Cursor="Hand"
                                Background="#0E639C" Foreground="#FFFFFF" BorderBrush="#1177BB"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty-state: shown when no concert is selected -->
                <TextBlock Grid.Column="1" x:Name="NoConcertSelectedText"
                           Text="Select a concert from the list, or click + Add to create one"
                           Foreground="#888888" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- ===== STEP 3 — Discs ===== -->
            <Grid x:Name="Step3Content" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Disc selector strip -->
                    <RowDefinition Height="*"/>      <!-- Track table for selected disc -->
                    <RowDefinition Height="Auto"/>  <!-- Track footer (+ Add Track) -->
                </Grid.RowDefinitions>

                <!-- Disc selector strip -->
                <Border Grid.Row="0" Background="#252526" Padding="12,8"
                        BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevDiscButton" Content="◀ Prev Disc"
                                Click="PrevDiscButton_Click"
                                Padding="8,4" Cursor="Hand"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>

                        <TextBlock x:Name="DiscSelectorText" Text="Disc 1 of 1"
                                   VerticalAlignment="Center" Margin="16,0"
                                   Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="14"/>

                        <Button x:Name="NextDiscButton" Content="Next Disc ▶"
                                Click="NextDiscButton_Click"
                                Padding="8,4" Cursor="Hand"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>

                        <Separator Width="1" Background="#3F3F46" Margin="16,4"/>

                        <Button x:Name="AddDiscButton" Content="+ Add Disc"
                                Click="AddDiscButton_Click"
                                Padding="8,4" Cursor="Hand" Margin="0,0,8,0"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>
                        <Button x:Name="RemoveDiscButton" Content="− Remove Disc"
                                Click="RemoveDiscButton_Click"
                                Padding="8,4" Cursor="Hand"
                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"/>

                        <Separator Width="1" Background="#3F3F46" Margin="16,4"/>

                        <TextBlock Text="DISC NAME:" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="DiscNameTextBox" Width="200" Padding="6,4"
                                 Background="#3C3C3C" Foreground="#FFFFFF"
                                 CaretBrush="#FFFFFF" BorderBrush="#555555"
                                 Text="{Binding DiscName, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                    </StackPanel>
                </Border>

                <!-- Track grid (binds to selected disc's Tracks via UpdateDiscSelector) -->
                <DataGrid Grid.Row="1" x:Name="TrackGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#1E1E1E" Foreground="#E0E0E0"
                          RowBackground="#252526" AlternatingRowBackground="#2A2A2D"
                          HorizontalGridLinesBrush="#3F3F46"
                          BorderBrush="#3F3F46" BorderThickness="1"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding TrackNumber, UpdateSourceTrigger=LostFocus}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                            Width="*" MinWidth="220"/>

                        <!-- Concert dropdown: SelectedValue=ConcertId, ItemsSource=wizard.ConcertOptions
                             via RelativeSource. Avoids putting ConcertOptions on the row VM. -->
                        <DataGridTemplateColumn Header="Concert" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding ConcertId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="DisplayLabel"
                                              ItemsSource="{Binding ConcertOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Song"
                                            Binding="{Binding SongName, UpdateSourceTrigger=LostFocus}"
                                            Width="200"/>

                        <DataGridCheckBoxColumn Header="Segue"
                                                Binding="{Binding SegueOut, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60"/>

                        <!-- Row actions: up / down / remove. Tag={Binding} so click handlers
                             see the row VM. -->
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="▲" Tag="{Binding}" Click="MoveTrackUpButton_Click"
                                                Width="24" Height="22" Padding="0" Margin="2,0,0,0"
                                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"
                                                ToolTip="Move up"/>
                                        <Button Content="▼" Tag="{Binding}" Click="MoveTrackDownButton_Click"
                                                Width="24" Height="22" Padding="0" Margin="2,0,0,0"
                                                Background="#3E3E42" Foreground="#CCCCCC" BorderBrush="#555555"
                                                ToolTip="Move down"/>
                                        <Button Content="✕" Tag="{Binding}" Click="RemoveTrackButton_Click"
                                                Width="24" Height="22" Padding="0" Margin="2,0,0,0"
                                                Background="#3E3E42" Foreground="#CC6666" BorderBrush="#663333"
                                                ToolTip="Remove"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer: + Add Track -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddTrackButton" Content="+ Add Track"
                            Click="AddTrackButton_Click"
                            Padding="10,6" Cursor="Hand"
                            Background="#0E639C" Foreground="#FFFFFF" BorderBrush="#1177BB"/>
                </StackPanel>
            </Grid>

            <!-- ===== STEP 4 — Review (placeholder; real content in commit 4c) ===== -->
            <TextBlock x:Name="Step4Content" Visibility="Collapsed"
                       Text="Step 4 — Review (coming next commit). Clicking Save will write the definition with the step-1 fields and empty concerts/discs."
                       Foreground="#888888" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
