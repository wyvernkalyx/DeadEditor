<UserControl x:Class="DeadEditor.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800"
             Background="#2D2D30"
             BorderBrush="#3E3E42"
             BorderThickness="0,0,0,1">

    <UserControl.Resources>
        <!-- Dark theme toggle button for ComboBox display area -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="#3E3E42"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Fill="#CCCCCC"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#888888"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark theme ComboBox style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,5,24,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="2"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark theme ComboBoxItem style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Library Header: "Library [Show: ▼] N dates [Edit Dates] [Search] [Advanced Search]" -->
        <Grid x:Name="LibraryHeader" Height="50" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Library"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- Show Type Filter (primary navigation) -->
                <TextBlock Text="Show:"
                           Foreground="#999999"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="20,0,6,0"/>
                <ComboBox x:Name="ShowTypeFilter"
                          Width="195"
                          VerticalAlignment="Center"
                          SelectionChanged="ShowTypeFilter_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Official Releases"/>
                    <ComboBoxItem Content="Audience Recordings"/>
                    <ComboBoxItem Content="By Date"/>
                    <ComboBoxItem Content="Shows I Don't Have"/>
                </ComboBox>

                <!-- Verification Filter (Album mode only) -->
                <TextBlock x:Name="VerificationLabel"
                           Text="Verified:"
                           Foreground="#999999"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0"/>
                <ComboBox x:Name="VerificationFilter"
                          Width="120"
                          VerticalAlignment="Center"
                          SelectionChanged="VerificationFilter_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Verified"/>
                    <ComboBoxItem Content="Partial"/>
                    <ComboBoxItem Content="Unverified"/>
                </ComboBox>

                <!-- Year Filter (Shows I Don't Have mode only) -->
                <TextBlock x:Name="YearLabel"
                           Text="Year:"
                           Foreground="#999999"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0"
                           Visibility="Collapsed"/>
                <ComboBox x:Name="YearFilter"
                          Width="105"
                          VerticalAlignment="Center"
                          SelectionChanged="YearFilter_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Visibility="Collapsed">
                    <ComboBoxItem Content="All Years" IsSelected="True"/>
                </ComboBox>

                <TextBlock x:Name="ConcertCountText"
                           Text="0 concerts"
                           Foreground="#888888"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <!-- Edit Dates button (By Date mode only, read-only state) -->
                <Button x:Name="EditDatesButton"
                        Content="Edit Dates"
                        Click="EditDatesButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        FontSize="14"
                        Visibility="Collapsed"/>

                <!-- Save / Cancel buttons (By Date edit mode only) -->
                <Button x:Name="SaveDatesButton"
                        Content="Save"
                        Click="SaveDatesButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        MinHeight="36"
                        Margin="0,0,6,0"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0E7A0D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#13A10E"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#13A10E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CancelDatesButton"
                        Content="Cancel"
                        Click="CancelDatesButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="14"
                        MinHeight="36"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Search Box -->
                <Grid Margin="12,0,0,0">
                    <TextBox x:Name="SearchBox"
                             Width="220"
                             FontSize="14"
                             Padding="8,6,28,6"
                             VerticalAlignment="Center"
                             Background="#3E3E42"
                             Foreground="#E0E0E0"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="CaretBrush" Value="#E0E0E0"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Placeholder text -->
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search library..."
                               Foreground="#777777"
                               FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <!-- Clear button -->
                    <Button x:Name="ClearSearchButton"
                            Content="✕"
                            Click="ClearSearchButton_Click"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Width="24" Height="24"
                            FontSize="12"
                            Cursor="Hand"
                            ToolTip="Clear search">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#555555"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Advanced Search Button -->
                <Button x:Name="AdvancedSearchButton"
                        Content="Advanced Search"
                        Click="AdvancedSearchButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        FontSize="14"
                        Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Album Detail Header: "[← Library]  {Album Name}  {Type}  ...  [Edit Metadata]" -->
        <Grid x:Name="AlbumDetailHeader" Height="50" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Content="← Library"
                        Margin="0,0,20,0"/>

                <TextBlock x:Name="AlbumNameText"
                           Text="Album Name"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <Border Background="#007ACC" CornerRadius="4" Padding="10,6">
                    <TextBlock x:Name="AlbumTypeText"
                               Text="Official Release"
                               Foreground="#FFFFFF"
                               FontSize="15"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="EditMetadataButton"
                        Content="Edit Metadata"
                        Click="EditMetadataButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        FontSize="16"
                        Margin="0,0,8,0"/>

                <Button x:Name="DeleteAlbumButton"
                        Content="Delete"
                        Click="DeleteAlbumButton_Click"
                        FontSize="16"
                        Padding="12,8"
                        Cursor="Hand"
                        MinHeight="36">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#442222"/>
                            <Setter Property="Foreground" Value="#CC6666"/>
                            <Setter Property="BorderBrush" Value="#663333"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#662222"/>
                                                <Setter Property="Foreground" Value="#FF8888"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Import Header: "[← Library]  Import  {status}" -->
        <Grid x:Name="ImportHeader" Height="50" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="ImportBackButton"
                        Click="ImportBackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Content="← Library"
                        Margin="0,0,20,0"/>

                <TextBlock Text="Import"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Edit Metadata Header: "[← Album Name]  Editing Metadata  [Save Changes]  [Cancel]" -->
        <Grid x:Name="EditMetadataHeader" Height="50" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="EditBackButton"
                        Click="EditBackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="0,0,20,0"/>

                <TextBlock Text="Editing Metadata"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="SaveChangesButton"
                        Content="Save Changes"
                        Click="SaveChangesButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        MinHeight="36"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0E7A0D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#13A10E"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#13A10E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CancelEditButton"
                        Content="Cancel"
                        Click="CancelEditButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="16"
                        MinHeight="36">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Concerts Header: "Concerts  {count} shows  [Search...]" -->
        <Grid x:Name="ConcertsHeader" Height="50" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Concerts"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ConcertsCountText"
                           Text="0 shows"
                           Foreground="#888888"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <!-- Ownership Filter -->
                <TextBlock Text="Show:"
                           Foreground="#999999"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0"/>
                <ComboBox x:Name="ConcertsOwnershipFilter"
                          Width="110"
                          VerticalAlignment="Center"
                          SelectionChanged="ConcertsOwnershipFilter_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Owned"/>
                    <ComboBoxItem Content="Missing"/>
                </ComboBox>

                <!-- Search Box -->
                <Grid Margin="16,0,0,0">
                    <TextBox x:Name="ConcertsSearchBox"
                             Width="280"
                             FontSize="14"
                             Padding="8,6,28,6"
                             VerticalAlignment="Center"
                             Background="#3E3E42"
                             Foreground="#E0E0E0"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             TextChanged="ConcertsSearchBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="CaretBrush" Value="#E0E0E0"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="ConcertsSearchPlaceholder"
                               Text="Search date, venue, city, or song..."
                               Foreground="#777777"
                               FontSize="14"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <Button x:Name="ConcertsClearSearchButton"
                            Content="&#x2715;"
                            Click="ConcertsClearSearchButton_Click"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Width="24" Height="24"
                            FontSize="12"
                            Cursor="Hand"
                            ToolTip="Clear search">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#555555"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Concert Detail Header: "[← Concerts]  {date}  [Edit Setlist]  [Delete]" -->
        <Grid x:Name="ConcertDetailHeader" Height="50" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="ConcertDetailBackButton"
                        Click="ConcertDetailBackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Content="← Concerts"
                        Margin="0,0,20,0"/>

                <TextBlock x:Name="ConcertDetailDateText"
                           Text=""
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="EditSetlistButton"
                        Content="Edit Setlist"
                        Click="EditSetlistButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        FontSize="16"
                        Margin="0,0,8,0"/>

                <Button x:Name="DeleteConcertButton"
                        Content="Delete"
                        Click="DeleteConcertButton_Click"
                        FontSize="16"
                        Padding="12,8"
                        Cursor="Hand"
                        MinHeight="36">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#442222"/>
                            <Setter Property="Foreground" Value="#CC6666"/>
                            <Setter Property="BorderBrush" Value="#663333"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#662222"/>
                                                <Setter Property="Foreground" Value="#FF8888"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Edit Setlist Header: "[← Venue]  Editing Setlist  [Save Changes]  [Cancel]" -->
        <Grid x:Name="EditSetlistHeader" Height="50" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="EditSetlistBackButton"
                        Click="EditSetlistBackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="0,0,20,0"/>

                <TextBlock Text="Editing Setlist"
                           Foreground="#E0E0E0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="SaveSetlistButton"
                        Content="Save Changes"
                        Click="SaveSetlistButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        MinHeight="36"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0E7A0D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#13A10E"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#13A10E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CancelSetlistButton"
                        Content="Cancel"
                        Click="CancelSetlistButton_Click"
                        Padding="12,8"
                        Cursor="Hand"
                        FontSize="16"
                        MinHeight="36">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Placeholder Header -->
        <Grid x:Name="PlaceholderHeader" Height="50" Visibility="Visible">
            <TextBlock x:Name="PlaceholderText"
                       Text="Placeholder"
                       Foreground="#E0E0E0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
