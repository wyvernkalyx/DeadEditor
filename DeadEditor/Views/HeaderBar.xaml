<UserControl x:Class="DeadEditor.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800"
             Background="#2D2D30">

    <UserControl.Resources>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Library Header: "Library  {count} concerts" -->
        <Grid x:Name="LibraryHeader" Height="50" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Library"
                           Foreground="#E0E0E0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ConcertCountText"
                           Text="0 concerts"
                           Foreground="#888888"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Album Detail Header: "[← Library]  {Album Name}  {Type}" -->
        <Grid x:Name="AlbumDetailHeader" Height="50" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Style="{StaticResource BackButtonStyle}"
                        Content="← Library"
                        Margin="0,0,20,0"/>

                <TextBlock x:Name="AlbumNameText"
                           Text="Album Name"
                           Foreground="#E0E0E0"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <Border Background="#007ACC" CornerRadius="4" Padding="10,6">
                    <TextBlock x:Name="AlbumTypeText"
                               Text="Official Release"
                               Foreground="#FFFFFF"
                               FontSize="14"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Placeholder Header -->
        <Grid x:Name="PlaceholderHeader" Height="50" Visibility="Visible">
            <TextBlock x:Name="PlaceholderText"
                       Text="Placeholder"
                       Foreground="#E0E0E0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
