<UserControl x:Class="DeadEditor.EditMetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#1E1E1E"
             Loaded="EditMetadataView_Loaded">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Album Info Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Track List + Artwork) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== SECTION 1: ALBUM INFO BAR ===== -->
        <Border Grid.Row="0" BorderBrush="#555555" BorderThickness="1"
                Background="#2D2D30" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Artist -->
                <Label Grid.Row="0" Grid.Column="0" Content="ARTIST" VerticalAlignment="Top"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="ArtistTextBox"
                         Margin="0,0,5,0" TextChanged="AlbumInfo_Changed"/>

                <!-- Concert Date -->
                <Label Grid.Row="0" Grid.Column="1" Content="DATE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlbumDateTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="yyyy-MM-dd (performance date)"/>

                <!-- Venue -->
                <Label Grid.Row="0" Grid.Column="2" Content="VENUE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="VenueTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"/>

                <!-- City, State -->
                <Label Grid.Row="0" Grid.Column="3" Content="CITY, STATE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="CityStateTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="City, ST"/>

                <!-- Album / Release Name -->
                <Label Grid.Row="0" Grid.Column="4" Content="ALBUM / RELEASE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="AlbumNameTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="Optional"/>

                <!-- Release Year -->
                <Label Grid.Row="0" Grid.Column="5" Content="YEAR" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="YearTextBox"
                         Margin="5,0,0,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="Release/publication year"/>
            </Grid>
        </Border>

        <!-- ===== SECTION 2: MAIN CONTENT (Track List + Artwork) ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Track List -->
            <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="1" Background="#1E1E1E" Margin="0,0,10,0">
                <DataGrid x:Name="TracksDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="CellOrRowHeader"
                          Background="#1E1E1E"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#252526"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#3F3F46"
                          FontSize="16"
                          RowHeight="28"
                          CellEditEnding="TracksDataGrid_CellEditEnding"
                          BeginningEdit="TracksDataGrid_BeginningEdit">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#264F78"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Track # (read-only display) -->
                        <DataGridTextColumn Header="#" Width="Auto" MinWidth="40"
                                            Binding="{Binding TrackNumber}"
                                            IsReadOnly="True"/>

                        <!-- Disc (editable) -->
                        <DataGridTextColumn Header="Disc" Width="Auto" MinWidth="40"
                                            Binding="{Binding DiscNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Title: shows DisplayTitle (with segue + date), edits SongName -->
                        <DataGridTemplateColumn Header="Title" Width="Auto" MinWidth="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"
                                               Padding="6,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding SongName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Background="#3C3C3C" Foreground="#FFFFFF"
                                             CaretBrush="#FFFFFF" BorderBrush="#007ACC"
                                             BorderThickness="1" Padding="4,2"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Segue (checkbox, single-click toggle) -->
                        <DataGridCheckBoxColumn Header="→" Width="Auto" MinWidth="30"
                                                Binding="{Binding Segue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Date (editable) -->
                        <DataGridTextColumn Header="Date" Width="Auto" MinWidth="100"
                                            Binding="{Binding TrackDate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#3C3C3C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Duration (read-only) -->
                        <DataGridTextColumn Header="Time" Width="Auto" MinWidth="60"
                                            Binding="{Binding Duration}"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Artwork Panel -->
            <StackPanel Grid.Column="1">
                <!-- Album Art -->
                <Grid Width="180" Height="180">
                    <Image x:Name="AlbumArtImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <Border x:Name="ArtworkPlaceholder"
                            Background="#2D2D30"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Visibility="Visible">
                        <TextBlock Text="&#x1F3B5;"
                                   FontSize="60"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Album Type (read-only display for now) -->
                <TextBlock x:Name="AlbumTypeText"
                           Text="Album Type"
                           Foreground="#888888"
                           FontSize="14"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>

                <!-- Track count -->
                <TextBlock x:Name="TrackCountText"
                           Text="0 tracks"
                           Foreground="#888888"
                           FontSize="14"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>

                <!-- Action buttons -->
                <Button x:Name="NormalizeButton" Content="Normalize"
                        Height="32" Width="160" Margin="0,16,0,0"
                        Click="NormalizeButton_Click" FontSize="14"
                        Background="#3C3C3C" Foreground="#FFFFFF"
                        BorderBrush="#555555"
                        ToolTip="Normalize song titles using fuzzy matching"/>
                <Button x:Name="RenumberButton" Content="Renumber"
                        Height="32" Width="160" Margin="0,6,0,0"
                        Click="RenumberButton_Click" FontSize="14"
                        Background="#3C3C3C" Foreground="#FFFFFF"
                        BorderBrush="#555555"
                        ToolTip="Renumber tracks sequentially (disc-aware)"/>
            </StackPanel>
        </Grid>

        <!-- ===== SECTION 3: STATUS BAR ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusTextBlock"
                       Text="Ready" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="#888888"/>

            <ProgressBar Grid.Column="1" x:Name="ProgressBar"
                         Width="200" Height="16"
                         Visibility="Collapsed"
                         Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
