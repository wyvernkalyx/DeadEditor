<UserControl x:Class="DeadEditor.EditMetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:markers="clr-namespace:DeadEditor.Helpers"
             xmlns:local="clr-namespace:DeadEditor"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#1E1E1E"
             Loaded="EditMetadataView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- Amber left-edge marker (prompt 6 / memo § 6 Scenario A) -->
                <Trigger Property="markers:EditMarkers.IsDirty" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource MarkerAmberAccent}"/>
                    <Setter Property="BorderThickness" Value="3,1,1,1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Action Bar (Normalize / Renumber) -->
            <RowDefinition Height="Auto"/>
            <!-- Album Info Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Track List + Artwork) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== SECTION 0: ACTION BAR ===== -->
        <Border Grid.Row="0" BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                Padding="0,0,0,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="NormalizeButton" Content="Normalize" Height="32"
                            Style="{StaticResource AccentButton}"
                            Click="NormalizeButton_Click" Margin="0,0,6,0" FontSize="16"
                            ToolTip="Normalize song titles using fuzzy matching"/>
                    <Button x:Name="RenumberButton" Content="Renumber" Height="32"
                            Style="{StaticResource TertiaryButton}"
                            Click="RenumberButton_Click" Margin="0,0,6,0" FontSize="16"
                            ToolTip="Renumber tracks sequentially (disc-aware)"/>
                    <Button x:Name="MatchSetlistButton" Content="Match Setlist" Height="32"
                            Style="{StaticResource AccentButton}"
                            Click="MatchSetlistButton_Click" Margin="0,0,6,0" FontSize="16"
                            IsEnabled="False"
                            ToolTip="No setlist data for this date"/>
                </StackPanel>

                <!-- Right: Normalization status -->
                <TextBlock Grid.Column="2" x:Name="NormalizeStatusText"
                           Text="" FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="#888888"/>
            </Grid>
        </Border>

        <!-- ===== SECTION 1: ALBUM INFO BAR ===== -->
        <Border Grid.Row="1" BorderBrush="#555555" BorderThickness="1"
                Background="#2D2D30" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Artist -->
                <Label Grid.Row="0" Grid.Column="0" Content="ARTIST" VerticalAlignment="Top"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="ArtistTextBox"
                         Margin="0,0,5,0" TextChanged="AlbumInfo_Changed"/>

                <!-- Concert Date -->
                <Label Grid.Row="0" Grid.Column="1" Content="DATE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlbumDateTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"
                         LostFocus="AlbumDateTextBox_LostFocus"
                         ToolTip="yyyy-MM-dd (performance date)"/>

                <!-- Venue -->
                <Label Grid.Row="0" Grid.Column="2" Content="VENUE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="VenueTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"/>

                <!-- City, State -->
                <Label Grid.Row="0" Grid.Column="3" Content="CITY, STATE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="CityStateTextBox"
                         Margin="5,0,5,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="City, ST"/>

                <!-- Album / Release Name (with autocomplete) -->
                <Label Grid.Row="0" Grid.Column="4" Content="ALBUM / RELEASE" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <Grid Grid.Row="1" Grid.Column="4" Margin="5,0,5,0">
                    <TextBox x:Name="AlbumNameTextBox"
                             TextChanged="AlbumInfo_Changed"
                             PreviewKeyDown="AlbumNameTextBox_PreviewKeyDown"
                             LostFocus="AlbumNameTextBox_LostFocus"
                             ToolTip="Optional — type to search known releases"/>
                    <Popup x:Name="AlbumNamePopup"
                           PlacementTarget="{Binding ElementName=AlbumNameTextBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="2"
                                MaxHeight="300" MinWidth="200">
                            <ListBox x:Name="AlbumNameSuggestions"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#CCCCCC"
                                     FontSize="14"
                                     MouseLeftButtonUp="AlbumNameSuggestions_MouseClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Release Year -->
                <Label Grid.Row="0" Grid.Column="5" Content="YEAR" VerticalAlignment="Top" Margin="5,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="YearTextBox"
                         Margin="5,0,0,0" TextChanged="AlbumInfo_Changed"
                         ToolTip="Release/publication year"/>
            </Grid>
        </Border>

        <!-- ===== SECTION 2: MAIN CONTENT (Track List + Artwork) ===== -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Track List -->
            <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="1" Background="#1E1E1E" Margin="0,0,10,0">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Validation banner: visible only when MetadataValidator surfaces issues. -->
                <Border Grid.Row="0" x:Name="ValidationBanner"
                        Background="#3F2D1A"
                        BorderBrush="#7A5A2E"
                        BorderThickness="0,0,0,1"
                        Padding="10,6"
                        Visibility="Collapsed">
                    <ItemsControl x:Name="ValidationIssuesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#F0AD4E"
                                           FontSize="13"
                                           Margin="0,1,0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <DataGrid Grid.Row="1" x:Name="TracksDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="CellOrRowHeader"
                          Background="#1E1E1E"
                          Foreground="#FFFFFF"
                          AlternationCount="2"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#3F3F46"
                          FontSize="16"
                          RowHeight="28"
                          CellEditEnding="TracksDataGrid_CellEditEnding"
                          BeginningEdit="TracksDataGrid_BeginningEdit"
                          MouseRightButtonUp="TracksDataGrid_MouseRightButtonUp"
                          AllowDrop="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0"/>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#264F78"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="MouseMove" Handler="Row_MouseMove"/>
                            <EventSetter Event="DragOver" Handler="Row_DragOver"/>
                            <EventSetter Event="Drop" Handler="Row_Drop"/>
                            <Setter Property="AllowDrop" Value="True"/>
                            <!-- Row backgrounds are owned here (not via the DataGrid's
                                 RowBackground/AlternatingRowBackground) so the amber
                                 unmatched trigger shares one precedence channel and can
                                 win. Base = normal row; AlternationIndex 1 = stripe;
                                 amber trigger declared LAST so it wins when active. -->
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Style.Triggers>
                                <!-- Alternating stripe (replaces AlternatingRowBackground). -->
                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="1">
                                    <Setter Property="Background" Value="#252526"/>
                                </DataTrigger>
                                <!-- Amber tint for tracks left unmatched after a Match Setlist run.
                                     Dim amber (validation-banner tone), readable under white text;
                                     cell-level selection (#264F78) still paints above it. Declared
                                     last so it overrides the alternation stripe. -->
                                <DataTrigger Binding="{Binding ShowUnmatchedWarning}" Value="True">
                                    <Setter Property="Background" Value="#3F2D1A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Track # (editable; integer; clamped to >=0 at the model setter) -->
                        <DataGridTextColumn Header="#" Width="Auto" MinWidth="40"
                                            Binding="{Binding TrackNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Disc (editable) -->
                        <DataGridTextColumn Header="Disc" Width="Auto" MinWidth="40"
                                            Binding="{Binding DiscNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Title: display shows aggregated DisplayTitle, edit targets SongName -->
                        <DataGridTemplateColumn Header="Title" Width="Auto" MinWidth="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Modified dot: soft blue, visible on both the
                                             normal (#1E1E1E) and amber (#3F2D1A) row backgrounds. -->
                                        <Ellipse Width="6" Height="6"
                                                 Margin="2,0,4,0"
                                                 VerticalAlignment="Center"
                                                 Fill="#4FC1FF"
                                                 ToolTip="Modified this session"
                                                 Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding SongName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3C3C3C"
                                             Foreground="#FFFFFF"
                                             CaretBrush="#FFFFFF"
                                             BorderBrush="#007ACC"
                                             BorderThickness="1"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Segue (checkbox, single-click toggle) -->
                        <DataGridCheckBoxColumn Header="&#x2192;" Width="Auto" MinWidth="30"
                                                Binding="{Binding Segue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Date (editable) -->
                        <DataGridTextColumn Header="Date" Width="Auto" MinWidth="100"
                                            Binding="{Binding TrackDate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#3C3C3C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Duration (read-only) -->
                        <DataGridTextColumn Header="Time" Width="Auto" MinWidth="60"
                                            Binding="{Binding Duration}"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Drop indicator line for drag-to-reorder -->
                <Border Grid.Row="1" x:Name="DropIndicator"
                        Background="#007ACC"
                        Height="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Reference Side-Panel (Setlist) — shared control, own toggle strip + collapse (spec
                 §3). Edit now offers the "Edit setlist ↗" deep-link (§9, unbanked): it navigates
                 DIRECTLY to the setlist editor and, on return, invalidates match state + rebuilds the
                 panel (the retained-instance Loaded re-fire is guarded so the tag re-read can't drop
                 in-progress edits). -->
            <local:SetlistReferencePanel x:Name="SetlistPanel" Grid.Column="1" Margin="0,0,10,0"
                                         ShowEditSetlistLink="True"/>

            <!-- Artwork Panel -->
            <StackPanel Grid.Column="2">
                <!-- Album Art -->
                <Grid Width="180" Height="180">
                    <Image x:Name="AlbumArtImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <Border x:Name="ArtworkPlaceholder"
                            Background="#2D2D30"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Visibility="Visible">
                        <TextBlock Text="&#x1F3B5;"
                                   FontSize="60"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Artwork buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="ChangeArtworkButton" Content="Change" Height="26"
                            Click="ChangeArtworkButton_Click" Margin="0,0,4,0" FontSize="12"
                            Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                            Padding="10,2" Cursor="Hand"
                            ToolTip="Select new album artwork"/>
                    <Button x:Name="RemoveArtworkButton" Content="Remove" Height="26"
                            Click="RemoveArtworkButton_Click" FontSize="12"
                            Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                            Padding="10,2" Cursor="Hand"
                            ToolTip="Remove album artwork"/>
                </StackPanel>

                <!-- View Info (Edit-side, net-new; reference-side-panel-spec.md §8). First-.txt
                     discovery over the show folder opens the info .txt in the OS default editor —
                     same shell-open as Import's View Info, so it can sit beside the setlist editor.
                     Lives in the view's own chrome (not the shared SetlistReferencePanel, which stays
                     a pure setlist display + event surface, §4). Disabled when no .txt exists. -->
                <Button x:Name="ViewInfoButton" Content="View Info"
                        Width="170" Height="24" Margin="0,8,0,0"
                        FontSize="12"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                        Padding="6,2" Cursor="Hand"
                        HorizontalAlignment="Center"
                        IsEnabled="False"
                        Click="ViewInfoButton_Click"
                        ToolTip="Open this album's info .txt in the default text editor"/>

                <!-- Verification badge -->
                <Border x:Name="VerificationBadge"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Padding="12,4"
                        CornerRadius="3"
                        Background="#3C3C3C">
                    <TextBlock x:Name="VerificationBadgeText"
                               Text="Unverified"
                               Foreground="#888888"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Verify / Unverify action -->
                <Button x:Name="VerifyButton"
                        Content="Verify"
                        Width="170" Height="24" Margin="0,6,0,0"
                        FontSize="12"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                        Padding="6,2" Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="VerifyButton_Click"
                        ToolTip="Mark this album as verified (Date and Artist required)"/>

                <!-- Archivist Note -->
                <Label Content="ARCHIVIST NOTE" Foreground="#999999" FontSize="11"
                       Padding="0" Margin="0,12,0,2" HorizontalAlignment="Center"/>
                <TextBox x:Name="ArchivistNoteTextBox"
                         Width="170" Height="90"
                         HorizontalAlignment="Center"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontSize="12"
                         Padding="6,4"
                         MinHeight="0"
                         TextChanged="ArchivistNoteTextBox_TextChanged"
                         ToolTip="Curator notes, sources, open questions about this recording"/>

                <!-- Album Type -->
                <Label Content="TYPE" Foreground="#999999" FontSize="11"
                       Padding="0" Margin="0,12,0,2" HorizontalAlignment="Center"/>
                <!-- Overlay grid: marker rectangle sits on top of the combobox left edge
                     so toggling visibility doesn't shift the combobox layout. -->
                <Grid HorizontalAlignment="Center" Width="170" Height="28">
                    <ComboBox x:Name="AlbumTypeComboBox"
                              Width="170" Height="28" FontSize="13"
                              Padding="6,4"
                              VerticalContentAlignment="Center"
                              Background="#3C3C3C" Foreground="#FFFFFF"
                              BorderBrush="#555555"
                              SelectionChanged="AlbumTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Audience Recording"/>
                        <ComboBoxItem Content="Official Release"/>
                    </ComboBox>
                    <Border x:Name="AlbumTypeMarkerBorder"
                            Width="3"
                            HorizontalAlignment="Left"
                            Background="{StaticResource MarkerAmberAccent}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                </Grid>

                <!-- Fingerprint summary -->
                <Label Content="FINGERPRINTS" Foreground="#999999" FontSize="11"
                       Padding="0" Margin="0,12,0,2" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FingerprintSummaryText"
                           Text="—"
                           Foreground="#888888"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Per-track Chromaprint fingerprint coverage"/>
                <Button x:Name="FingerprintButton"
                        Content="&#x1F3B5; Fingerprint"
                        Width="170" Height="24" Margin="0,4,0,0"
                        FontSize="12"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555"
                        Padding="6,2" Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="FingerprintButton_Click"
                        ToolTip="Compute Chromaprint fingerprints for tracks that don't have one"/>

                <!-- Track count -->
                <TextBlock x:Name="TrackCountText"
                           Text="0 tracks"
                           Foreground="#888888"
                           FontSize="14"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== SECTION 3: STATUS BAR ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Folder path + Open Folder button -->
            <DockPanel Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="OpenFolderButton" DockPanel.Dock="Right"
                        Height="26" Click="OpenFolderButton_Click"
                        Margin="6,0,12,0"
                        ToolTip="Open this folder in File Explorer"
                        Padding="8,2" Cursor="Hand"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderBrush="#555555">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Open Folder" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="FolderPathTextBox"
                         Text="(unknown)"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#AAAAAA"
                         FontSize="13"
                         Padding="0"
                         MinHeight="0"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         IsTabStop="False"
                         MaxWidth="500"/>
            </DockPanel>

            <TextBlock Grid.Column="1" x:Name="StatusTextBlock"
                       Text="Ready" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="#888888"/>

            <ProgressBar Grid.Column="2" x:Name="ProgressBar"
                         Width="200" Height="16"
                         Visibility="Collapsed"
                         Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
