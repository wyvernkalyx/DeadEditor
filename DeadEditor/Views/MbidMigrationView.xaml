<UserControl x:Class="DeadEditor.Views.MbidMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="30">
        <!-- START SCREEN -->
        <StackPanel x:Name="StartPanel" Visibility="Visible">
            <TextBlock Text="MusicBrainz Release ID Migration" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

            <TextBlock Text="This tool walks your library, looks up each untagged album on MusicBrainz, and writes the release MBID to every track after your confirmation."
                       FontSize="14" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <!-- Counts panel -->
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total albums in library:" Foreground="#CCCCCC" FontSize="14"/>
                        <TextBlock x:Name="TotalCountText" Grid.Column="1" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Already tagged (will be skipped):" Foreground="#4EC9B0" FontSize="14"/>
                        <TextBlock x:Name="TaggedCountText" Grid.Column="1" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Needing migration:" Foreground="#569CD6" FontSize="14"/>
                        <TextBlock x:Name="NeedsMigrationText" Grid.Column="1" Foreground="#569CD6" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Resume banner -->
            <Border x:Name="ResumeBanner" Background="#2D3A4D" BorderBrush="#3E5A7D" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ResumeText" FontSize="14" Foreground="#AACCFF" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Resume" Click="ResumeButton_Click" Height="32" Padding="16,4" Margin="0,0,8,0"
                                Background="#3C5A8C" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                        <Button Content="Start Fresh" Click="StartFreshButton_Click" Height="32" Padding="16,4"
                                Background="#3C3C3C" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dry-run toggle -->
            <CheckBox x:Name="DryRunCheckBox" Margin="0,0,0,20">
                <TextBlock Text="Dry run (preview only — no tags will be modified)" Foreground="#CCCCCC" FontSize="14"/>
            </CheckBox>

            <!-- Start button -->
            <Button x:Name="StartButton" Content="Start Migration" Click="StartButton_Click"
                    Height="40" Width="200" HorizontalAlignment="Left"
                    Background="#2D5F2D" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A7A3A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- PROGRESS SCREEN -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock Text="Migration in Progress" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

            <TextBlock x:Name="DryRunBanner" Text="DRY RUN MODE — no tags will be modified" FontSize="14" Foreground="#FFCC00" Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBlock x:Name="FpcalcWarningText" FontSize="13" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <!-- Current album -->
            <TextBlock Text="Current album:" FontSize="13" Foreground="#999999" Margin="0,0,0,4"/>
            <TextBlock x:Name="CurrentAlbumText" FontSize="14" Foreground="#E0E0E0" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- Progress bar -->
            <ProgressBar x:Name="MigrationProgressBar" Height="24" Margin="0,0,0,8"
                         Background="#333333" Foreground="#569CD6" BorderThickness="0"/>
            <TextBlock x:Name="ProgressText" FontSize="13" Foreground="#CCCCCC" Margin="0,0,0,16"/>

            <!-- Running totals -->
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="MatchedText" Text="Matched: 0" FontSize="13" Foreground="#4EC9B0" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SkippedText" Text="Skipped: 0" FontSize="13" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                    <TextBlock x:Name="FailedText" Text="Failed: 0" FontSize="13" Foreground="#FF6666" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click"
                        Height="34" Width="100" Margin="0,0,8,0"
                        Background="#3C3C3C" Foreground="#FFFFFF" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                        Height="34" Width="100"
                        Background="#3C3C3C" Foreground="#FFFFFF" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- COMPLETION SCREEN -->
        <StackPanel x:Name="CompletionPanel" Visibility="Collapsed">
            <TextBlock x:Name="CompletionTitle" Text="Migration Complete" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

            <TextBlock x:Name="CompletionDryRunBanner" Text="DRY RUN — no tags were modified" FontSize="15" Foreground="#FFCC00" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="Collapsed"/>

            <!-- Summary counts -->
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="SummaryMatchedText" FontSize="14" Foreground="#4EC9B0" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SummarySkippedText" FontSize="14" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SummaryAlreadyTaggedText" FontSize="14" Foreground="#888888" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SummaryFailedText" FontSize="14" Foreground="#FF6666" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Failures list -->
            <Expander x:Name="FailuresExpander" Header="Failed Albums" Foreground="#FF6666" FontSize="14" Margin="0,0,0,20" Visibility="Collapsed">
                <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FailuresPanel"/>
                    </ScrollViewer>
                </Border>
            </Expander>

            <!-- Dry-run message -->
            <TextBlock x:Name="DryRunMessage" FontSize="14" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,0,0,20" Visibility="Collapsed"
                       Text="Run again with dry-run disabled to apply changes."/>

            <!-- Close button -->
            <Button Content="Close" Click="CloseButton_Click"
                    Height="36" Width="100" HorizontalAlignment="Left"
                    Background="#3C3C3C" Foreground="#FFFFFF" FontSize="14" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
