<UserControl x:Class="DeadEditor.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Player Button Style -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Seek Slider Style -->
        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Volume Slider Style -->
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid Height="60">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- Transport controls -->
            <ColumnDefinition Width="*"/>     <!-- Track info + seek bar -->
            <ColumnDefinition Width="Auto"/>  <!-- Volume -->
        </Grid.ColumnDefinitions>

        <!-- Transport Controls -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,10,0">
            <Button x:Name="PreviousButton"
                    Click="PreviousButton_Click"
                    Style="{StaticResource PlayerButtonStyle}"
                    ToolTip="Previous Track">
                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
            </Button>

            <Button x:Name="PlayButton"
                    Click="PlayButton_Click"
                    Style="{StaticResource PlayerButtonStyle}"
                    ToolTip="Play/Pause"
                    Margin="5,0,5,0">
                <TextBlock x:Name="PlayButtonIcon"
                          Text="&#xE768;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="24"/>
            </Button>

            <Button x:Name="NextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource PlayerButtonStyle}"
                    ToolTip="Next Track">
                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
            </Button>
        </StackPanel>

        <!-- Track Info + Seek Bar -->
        <Grid Grid.Column="1" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Marquee Track Title -->
            <Canvas Grid.Row="0" x:Name="MarqueeCanvas" ClipToBounds="True">
                <TextBlock x:Name="MarqueeText"
                          Text="No track playing"
                          Foreground="#CCCCCC"
                          FontSize="16"
                          VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTransform" X="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <!-- Seek Bar + Time -->
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Slider x:Name="SeekSlider"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp"
                        Style="{StaticResource SeekSliderStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock x:Name="CurrentTimeText"
                              Text="0:00"
                              Foreground="#999999"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                    <TextBlock Text=" / "
                              Foreground="#666666"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalTimeText"
                              Text="0:00"
                              Foreground="#999999"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Volume Control -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,10,0">
            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                      Foreground="#999999"
                      FontSize="16"
                      VerticalAlignment="Center"
                      Margin="0,0,5,0"/>
            <Slider x:Name="VolumeSlider"
                    Width="80"
                    Minimum="0"
                    Maximum="100"
                    Value="75"
                    VerticalAlignment="Center"
                    ValueChanged="VolumeSlider_ValueChanged"
                    Style="{StaticResource VolumeSliderStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
