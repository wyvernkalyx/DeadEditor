<Window x:Class="DeadEditor.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadEditor"
        xmlns:views="clr-namespace:DeadEditor.Views"
        mc:Ignorable="d"
        Title="Dead Editor"
        Icon="pack://application:,,,/Resources/app-icon.ico"
        Width="1600" Height="1000"
        WindowState="Maximized"
        Background="#1E1E1E"
        FontSize="16"
        Closing="ShellWindow_Closing"
        PreviewKeyDown="ShellWindow_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>  <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Content -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Playlist -->
            <RowDefinition Height="Auto"/>  <!-- Player Bar -->
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <local:SidebarPanel Grid.Column="0" Grid.RowSpan="4"
                           x:Name="SidebarPanel"
                           NavigationRequested="SidebarPanel_NavigationRequested"/>

        <!-- Header Bar -->
        <local:HeaderBar Grid.Column="1" Grid.Row="0"
                        x:Name="HeaderBar"/>

        <!-- Main Content Area -->
        <ContentPresenter Grid.Column="1" Grid.Row="1"
                         x:Name="ContentPresenter"
                         Content="{Binding CurrentView, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <!-- In-window alert banner: overlays the top of the content cell, layered above the
             swappable ContentPresenter (same cell, higher Z) so it survives view switches and
             stays within the content area — never colliding with the sidebar, header, playlist,
             or docked player bar. Collapsed when idle. -->
        <views:AlertBannerHost Grid.Column="1" Grid.Row="1"
                         x:Name="AlertBanner"
                         VerticalAlignment="Top"
                         Panel.ZIndex="10"/>

        <!-- Playlist Panel -->
        <local:PlaylistPanel Grid.Column="1" Grid.Row="2"
                            x:Name="PlaylistPanel"/>

        <!-- Player Bar -->
        <local:PlayerBar Grid.Column="1" Grid.Row="3"
                        x:Name="PlayerBar"/>

        <!-- In-window read panel (alert-system-spec.md Ruling 3): full-shell dimmed scrim + LARGE
             centered card for viewing a long text document (bucket C, the Import info-file viewer).
             Spans the whole shell at ZIndex 50 — ABOVE the banner (10) so it dims everything, but
             BELOW the confirm host (100) so a blocking DECISION still outranks an informational
             viewer. A banner firing behind the scrim renders occluded and resurfaces unchanged when
             the panel closes. Collapsed when idle. -->
        <views:ReadPanelHost Grid.Column="0" Grid.Row="0"
                         Grid.ColumnSpan="2" Grid.RowSpan="4"
                         x:Name="ReadPanel"
                         Panel.ZIndex="50"/>

        <!-- In-window status overlay (alert-system-spec.md § Status overlay): full-shell dimmed scrim
             + centered card with an indeterminate spinner for long/blocking operations (the cold
             concert-database load; future media import). Spans the whole shell at ZIndex 75 — ABOVE
             the read panel (50) but BELOW the confirm host (100), so a blocking DECISION can still
             surface above a please-wait. Non-cancelable; the shell swallows every key while it shows.
             Collapsed when idle. No caller is wired yet (Commit B). -->
        <views:StatusHost Grid.Column="0" Grid.Row="0"
                         Grid.ColumnSpan="2" Grid.RowSpan="4"
                         x:Name="StatusHost"
                         Panel.ZIndex="75"/>

        <!-- In-window confirm host (alert-system-spec.md Ruling 2): full-shell dimmed scrim +
             centered card for bucket-B blocking decisions. Spans every column and row (sidebar,
             header, content, playlist, player) at a higher Z than the banner layer (ZIndex 10) so a
             blocking decision dims and blocks the ENTIRE shell, banner included. Collapsed when idle;
             banners may still fire behind the scrim without breaking. -->
        <views:ConfirmHost Grid.Column="0" Grid.Row="0"
                         Grid.ColumnSpan="2" Grid.RowSpan="4"
                         x:Name="ConfirmHost"
                         Panel.ZIndex="100"/>
    </Grid>
</Window>
