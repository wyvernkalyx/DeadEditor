<Window x:Class="DeadEditor.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadEditor"
        xmlns:views="clr-namespace:DeadEditor.Views"
        mc:Ignorable="d"
        Title="Dead Editor"
        Icon="pack://application:,,,/Resources/app-icon.ico"
        Width="1600" Height="1000"
        WindowState="Maximized"
        Background="#1E1E1E"
        FontSize="16"
        Closing="ShellWindow_Closing"
        PreviewKeyDown="ShellWindow_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>  <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Content -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Playlist -->
            <RowDefinition Height="Auto"/>  <!-- Player Bar -->
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <local:SidebarPanel Grid.Column="0" Grid.RowSpan="4"
                           x:Name="SidebarPanel"
                           NavigationRequested="SidebarPanel_NavigationRequested"/>

        <!-- Header Bar -->
        <local:HeaderBar Grid.Column="1" Grid.Row="0"
                        x:Name="HeaderBar"/>

        <!-- Main Content Area -->
        <ContentPresenter Grid.Column="1" Grid.Row="1"
                         x:Name="ContentPresenter"
                         Content="{Binding CurrentView, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <!-- In-window alert banner: overlays the top of the content cell, layered above the
             swappable ContentPresenter (same cell, higher Z) so it survives view switches and
             stays within the content area — never colliding with the sidebar, header, playlist,
             or docked player bar. Collapsed when idle. -->
        <views:AlertBannerHost Grid.Column="1" Grid.Row="1"
                         x:Name="AlertBanner"
                         VerticalAlignment="Top"
                         Panel.ZIndex="10"/>

        <!-- Playlist Panel -->
        <local:PlaylistPanel Grid.Column="1" Grid.Row="2"
                            x:Name="PlaylistPanel"/>

        <!-- Player Bar -->
        <local:PlayerBar Grid.Column="1" Grid.Row="3"
                        x:Name="PlayerBar"/>
    </Grid>
</Window>
